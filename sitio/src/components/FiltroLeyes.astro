---
// Filtros del catálogo. Sin JavaScript queda oculto y se ve la lista completa.
// Con JavaScript filtra y ordena las filas de la tabla y refleja los filtros en la dirección.
import { ORDENES, ORDEN_PREDETERMINADO } from "../lib/filtro.js";
import { parametrosCatalogo } from "../lib/rutas.js";
import { textos } from "../lib/contenido.js";
const tx = textos.leyes.filtro;
const txc = textos.general.comunes;

interface Props {
  entradas: any[];
  anios: string[];
  camaras: { valor: string; etiqueta: string }[];
  temas: { valor: string; etiqueta: string; total: number }[];
  idTabla: string;
}
const { entradas, anios, camaras, temas, idTabla } = Astro.props;
const p = parametrosCatalogo;
---

<form class="filtro" id="filtro-leyes" role="search" hidden data-tabla={idTabla}>
  <div class="campo texto">
    <label for="filtro-texto">{tx.numeroOPalabrasDelTitulo}</label>
    <input type="search" id="filtro-texto" name={p.texto} autocomplete="off" />
  </div>
  <div class="campo">
    <label for="filtro-anio">{tx.anoDeSancion}</label>
    <select id="filtro-anio" name={p.anio}>
      <option value="">{txc.todos}</option>
      {anios.map((a) => <option value={a}>{a}</option>)}
    </select>
  </div>
  <div class="campo">
    <label for="filtro-camara">{txc.camaraDeOrigen}</label>
    <select id="filtro-camara" name={p.camara}>
      <option value="">{txc.lasDos}</option>
      {camaras.map((c) => <option value={c.valor}>{c.etiqueta}</option>)}
    </select>
  </div>
  <div class="campo">
    <label for="filtro-tema">{tx.temaClasificacionDelObservatorio}</label>
    <select id="filtro-tema" name={p.tema}>
      <option value="">{txc.todos}</option>
      {temas.map((t) => <option value={t.valor}>{t.etiqueta} ({t.total})</option>)}
    </select>
  </div>
  <div class="campo">
    <label for="filtro-orden">{tx.ordenarPor}</label>
    <select id="filtro-orden" name={p.orden}>
      {
        Object.entries(ORDENES).map(([valor, texto]) => (
          <option value={valor} selected={valor === ORDEN_PREDETERMINADO}>
            {texto}
          </option>
        ))
      }
    </select>
  </div>
  <div class="campo acciones">
    <button type="reset">{tx.limpiar}</button>
  </div>
  <p class="resultado" id="filtro-resultado" aria-live="polite"></p>
</form>

<script type="application/json" id="filtro-entradas" set:html={JSON.stringify(entradas)} />

<script>
  import { escribirFiltros, filtrar, leerFiltros } from "../lib/filtro.js";
  import { parametrosCatalogo as nombres } from "../lib/rutas.js";
  import interaccion from "../contenido/interaccion.json";
  import { fill } from "../lib/rellenar.js";
  const ti = interaccion.filtroLeyes;

  const form = document.getElementById("filtro-leyes") as HTMLFormElement;
  const tabla = document.getElementById(form.dataset.tabla!)!;
  const cuerpo = tabla.querySelector("tbody")!;
  const resultado = document.getElementById("filtro-resultado")!;
  const entradas = JSON.parse(document.getElementById("filtro-entradas")!.textContent!);
  const filas = new Map(
    [...cuerpo.querySelectorAll<HTMLTableRowElement>("tr[data-numero]")].map((f) => [f.dataset.numero, f]),
  );
  const campos = {
    texto: form.elements.namedItem(nombres.texto) as HTMLInputElement,
    anio: form.elements.namedItem(nombres.anio) as HTMLSelectElement,
    camara: form.elements.namedItem(nombres.camara) as HTMLSelectElement,
    tema: form.elements.namedItem(nombres.tema) as HTMLSelectElement,
    orden: form.elements.namedItem(nombres.orden) as HTMLSelectElement,
  };
  const total = entradas.length;
  const formato = new Intl.NumberFormat("es-PY");

  function aplicar(filtros: ReturnType<typeof leerFiltros>, actualizarDireccion: boolean) {
    const elegidas = filtrar([...entradas], filtros);
    const visibles = new Set(elegidas.map((e: any) => e.numero));
    for (const [numero, fila] of filas) fila.hidden = !visibles.has(numero);
    cuerpo.append(...elegidas.map((e: any) => filas.get(e.numero)!));
    resultado.textContent =
      elegidas.length === total
        ? fill(ti.todas, { total: formato.format(total) })
        : elegidas.length === 0
          ? ti.ninguna
          : elegidas.length === 1
            ? fill(ti.una, { total: formato.format(total) })
          : fill(ti.varias, { visibles: formato.format(elegidas.length), total: formato.format(total) });
    if (actualizarDireccion) {
      const consulta = escribirFiltros(filtros, nombres).toString();
      history.replaceState(null, "", consulta ? `?${consulta}` : location.pathname);
    }
  }

  function desdeFormulario() {
    return leerFiltros(new URLSearchParams(new FormData(form) as any), nombres);
  }

  // Estado inicial desde la dirección (enlace compartido).
  const inicial = leerFiltros(new URLSearchParams(location.search), nombres);
  campos.texto.value = inicial.texto;
  campos.anio.value = [...campos.anio.options].some((o) => o.value === inicial.anio) ? inicial.anio : "";
  campos.camara.value = [...campos.camara.options].some((o) => o.value === inicial.camara) ? inicial.camara : "";
  campos.tema.value = [...campos.tema.options].some((o) => o.value === inicial.tema) ? inicial.tema : "";
  campos.orden.value = inicial.orden;
  form.hidden = false;
  aplicar(desdeFormulario(), false);

  let espera: ReturnType<typeof setTimeout>;
  form.addEventListener("input", () => {
    clearTimeout(espera);
    espera = setTimeout(() => aplicar(desdeFormulario(), true), 150);
  });
  form.addEventListener("submit", (e) => e.preventDefault());
  form.addEventListener("reset", () => setTimeout(() => aplicar(desdeFormulario(), true)));
</script>

<style>
  .filtro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--ancho-campo-filtro), 1fr));
    gap: var(--espacio-3);
    align-items: end;
    padding: var(--espacio-4);
    margin-bottom: var(--espacio-4);
    background: var(--color-superficie);
    border: var(--borde-ancho) solid var(--color-borde);
    border-radius: var(--radio);
  }
  .filtro[hidden] {
    display: none;
  }
  .texto {
    grid-column: 1 / -1;
  }
  .resultado {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
</style>
