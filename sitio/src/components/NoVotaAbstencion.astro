---
// NO VOTA y ABSTENCIÓN/BLANCO de un legislador en votaciones nominales, dos cifras separadas con el
// mismo denominador que las ausencias. Recibe el bloque de lib/legisladores.js (ficha).
import * as rutas from "../lib/rutas.js";
import { textos, md, crudo } from "../lib/contenido.js";
const tx = textos.legisladores.noVotaAbstencion;

interface Props {
  noVota: any;
  abstencion: any;
  periodo: string;
}
const { noVota, abstencion, periodo } = Astro.props;
---

<dl class="no-vota-abstencion">
  <div><dt>{tx.noVota}</dt><dd><strong>{noVota.texto}</strong></dd></div>
  <div><dt>{tx.abstencionBlanco}</dt><dd><strong>{abstencion.texto}</strong></dd></div>
</dl>
<p class="chico texto-suave lectura" set:html={md(tx.votacionesNominalesDelPeriodoEn, { periodo: periodo, url1: crudo(rutas.metodologia(rutas.anclasMetodologia.noVotaAbstencion)), url2: crudo(rutas.votacionesNominales()) })} />

<style>
  .no-vota-abstencion {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3) var(--espacio-5);
    margin: 0 0 var(--espacio-1);
  }
  dt {
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  dd {
    margin: 0;
    font-size: var(--tamano-titulo-3);
  }
</style>
