---
// Muestra uno o varios valores oficiales tal como vienen. Si los registros de una misma ley
// publican valores distintos, se muestran todos.
import { textos } from "../lib/contenido.js";
const txc = textos.general.comunes;
interface Props {
  valores: string[];
  vacio?: string;
}
const { valores, vacio = txc.sinDato } = Astro.props;
---

{
  valores.length === 0 ? (
    <span class="texto-suave">{vacio}</span>
  ) : valores.length === 1 ? (
    <Fragment>{valores[0]}</Fragment>
  ) : (
    <ul class="varios">
      {valores.map((v) => (
        <li>{v}</li>
      ))}
    </ul>
  )
}

<style>
  .varios {
    margin: 0;
    padding-left: var(--espacio-4);
  }
  .varios li + li {
    margin-top: var(--espacio-1);
  }
</style>
