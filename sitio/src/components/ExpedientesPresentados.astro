---
// Expedientes de los que un legislador figura como autor en el período: totales por tipo oficial y, de
// sus proyectos de ley, cantidad y porcentaje por estado oficial, con enlace a la lista en su página
// aparte. Recibe los valores de lib/expedientes.js. Estilos globales con prefijo de clase.
import * as rutas from "../lib/rutas.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.legisladores.expedientes;
const txc = textos.general.comunes;

interface Props {
  expedientes: any;
  periodo: string;
  urlLista: string;
}
const { expedientes: e, periodo, urlLista } = Astro.props;
const sinDato = txc.sinDato;
const leyes = e.proyectosDeLey;
---

<div class="expedientes-presentados">
  {
    e.total === 0 ? (
      <p class="lectura">{fill(tx.noFiguraEntreLosAutores, { periodo: periodo })}</p>
    ) : (
      <Fragment>
        <table>
          <caption class="solo-lectores">{tx.expedientesPresentadosPorTipo}</caption>
          <thead>
            <tr><th scope="col">{tx.tipoDeExpediente}</th><th scope="col">{tx.cantidad}</th></tr>
          </thead>
          <tbody data-paginar>
            {e.porTipo.map((t: any) => <tr><td>{t.tipo ?? sinDato}</td><td class="numero">{t.cantidad}</td></tr>)}
          </tbody>
        </table>
        {
          leyes.total > 0 && (
            <Fragment>
              <table>
                <caption>{fill(tx.susProyectosDeLeyPor, { total: leyes.total })}</caption>
                <thead>
                  <tr><th scope="col">{txc.estado}</th><th scope="col">{tx.proyectosDeLey}</th></tr>
                </thead>
                <tbody data-paginar>
                  {leyes.porEstado.map((x: any) => <tr><td>{x.estado ?? sinDato}</td><td class="numero">{x.texto}</td></tr>)}
                </tbody>
              </table>
              <p set:html={md(tx.verLaListaDeSus, { url1: crudo(urlLista), total: leyes.total })} />
            </Fragment>
          )
        }
      </Fragment>
    )
  }
  <p class="chico texto-suave lectura" set:html={md(tx.expedientesIngresadosDesdeElInicio, { url1: crudo(rutas.metodologia(rutas.anclasMetodologia.expedientes)) })} />
</div>

<style is:global>
  .expedientes-presentados table {
    border-collapse: collapse;
    font-size: var(--tamano-chico);
    margin-bottom: var(--espacio-4);
  }
  .expedientes-presentados caption {
    text-align: left;
    font-weight: bold;
    margin-bottom: var(--espacio-1);
  }
  .expedientes-presentados th,
  .expedientes-presentados td {
    text-align: left;
    vertical-align: top;
    padding: var(--espacio-1) var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
  }
  .expedientes-presentados thead th {
    border-bottom-width: var(--foco-ancho);
  }
  .expedientes-presentados .numero {
    white-space: nowrap;
    text-align: right;
  }
</style>
