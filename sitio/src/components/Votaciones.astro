---
// Votaciones nominales de un registro de ley: índice por fecha y una sección por cámara.
import Votacion from "./Votacion.astro";
import * as rutas from "../lib/rutas.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.leyes.votacionesDeLaLey;
const txc = textos.general.comunes;

interface Props {
  votaciones: any;
  periodo: string;
  nivel: number;
}
const { votaciones: vs, periodo, nivel } = Astro.props;
const Titulo = `h${nivel}`;
const Camara = `h${nivel + 1}`;
const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
---

<section class="votaciones" data-pagefind-ignore="all">
  <Titulo>{fill(tx.votacionesNominales, { cantidad: vs.cantidad })}</Titulo>
  {
    vs.cantidad === 0 ? (
      <p class="aviso lectura">
        {fill(tx.estaLeyNoTieneVotaciones, { periodo: periodo })}
      </p>
    ) : (
      <Fragment>
        <p class="aviso chico lectura" set:html={md(tx.partidoYBancadaSonLos, { periodo: periodo, url1: crudo(rutas.metodologia(rutas.anclasMetodologia.afiliacion)), url2: crudo(rutas.metodologia(rutas.anclasMetodologia.categorias)) })} />
        <p class="chico texto-suave">{tx.indiceDeLasVotacionesDe}</p>
        <ol class="indice chico">
          {vs.indice.map((v: any) => (
            <li>
              <a href={`#${v.ancla}`}>
                {v.fecha} · {v.camara} · {v.etapa} · {v.resultado}
              </a>
              {v.descripcionCorta && <span class="texto-suave"> — {v.descripcionCorta}</span>}
            </li>
          ))}
        </ol>
        {vs.camaras.map((c: any) => (
          <section>
            <Camara class="camara">
              {c.camara ?? txc.sinDato} ({plural(c.votaciones.length, txc.votacion, "votaciones")})
            </Camara>
            {c.votaciones.map((v: any) => (
              <Votacion votacion={v} nivel={nivel + 2} />
            ))}
          </section>
        ))}
      </Fragment>
    )
  }
  {
    vs.otrosPeriodos.length > 0 && (
      <div class="aviso lectura">
        <p>
          {tx.estaLeyTuvo}{vs.cantidad > 0 && tx.ademas} {plural(vs.otrosPeriodos.length, txc.votacionNominal, txc.votacionesNominales)} 
          {tx.enOtraLegislaturaQueEste}
        </p>
        <ul>
          {vs.otrosPeriodos.map((o: any) => (
            <li set:html={md(tx.votacion, { url1: crudo(o.url), id: o.id })} />
          ))}
        </ul>
      </div>
    )
  }
  {
    vs.noResueltas.length > 0 && (
      <div class="aviso lectura">
        <p>
          {tx.elProyectoTieneAdemas} {plural(vs.noResueltas.length, txc.votacion, "votaciones")} {tx.cuyoTramiteNoFiguraEntre}
        </p>
        <ul>
          {vs.noResueltas.map((o: any) => (
            <li set:html={md(tx.votacion, { url1: crudo(o.url), id: o.id })} />
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .aviso {
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--color-superficie);
    border-left: var(--foco-ancho) solid var(--color-acento);
  }
  .aviso p:last-child,
  .aviso ul {
    margin-bottom: 0;
  }
  .indice {
    padding-left: var(--espacio-5);
  }
  .camara {
    margin-top: var(--espacio-6);
  }
</style>
