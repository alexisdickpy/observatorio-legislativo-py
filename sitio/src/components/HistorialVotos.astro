---
// Voto de un legislador en cada votación nominal sobre un proyecto de ley, de la más reciente a la
// más antigua. Las de leyes sancionadas enlazan a la votación en la ficha de la ley; las demás, al
// expediente oficial en SILpy. Recibe el historial de lib/legisladores.js; cada fila lleva el valor
// de filtro del estado del proyecto (componente FiltroVotos).
// Filas en una sola línea y estilos globales con prefijo de clase (ver TablaLegisladores).
import { textos, fill } from "../lib/contenido.js";
const tx = textos.legisladores.historial;
const txc = textos.general.comunes;
interface Props {
  historial: any[];
}
const { historial } = Astro.props;
const sinDato = txc.sinDato;
---

<div class="historial-desplazable">
  <table class="historial-votos">
    <caption class="solo-lectores">{tx.votoEnCadaVotacionNominal}</caption>
    <thead>
      <tr>
        <th scope="col">{txc.fecha}</th>
        <th scope="col">{tx.proyecto}</th>
        <th scope="col">{txc.estadoDelProyecto}</th>
        <th scope="col">{tx.tramite}</th>
        <th scope="col">{tx.resultado}</th>
        <th scope="col">{tx.suVoto}</th>
      </tr>
    </thead>
    <tbody data-paginar>
      {historial.map((h) => <tr data-estado={h.proyecto.estadoFiltro}><td>{h.fecha ?? sinDato}</td><td>{h.leyes.length ? h.leyes.map((l: any) => <p><a href={l.url}>{fill(tx.ley, { numero: l.numero })}</a>{l.tituloCorto && <span class="texto-suave"> {l.tituloCorto}</span>}</p>) : <p>{h.proyecto.url ? <a href={h.proyecto.url}>{txc.expediente} {h.proyecto.expediente ?? sinDato}</a> : fill(textos.general.comunes.expedienteNumero, { expediente: h.proyecto.expediente ?? sinDato })}{h.proyecto.tituloCorto && <span class="texto-suave"> {h.proyecto.tituloCorto}</span>}</p>}</td><td>{h.proyecto.estado ?? sinDato}</td><td>{h.etapa ?? sinDato}</td><td>{h.resultado ?? sinDato}</td><td class="voto"><span class={`cuadro ${h.clase}`}></span>{h.sentido}{h.observacion && <span class="texto-suave"> ({h.observacion})</span>}</td></tr>)}
    </tbody>
  </table>
</div>

<style is:global>
  .historial-desplazable {
    overflow-x: auto;
  }
  .historial-votos {
    border-collapse: collapse;
    font-size: var(--tamano-chico);
    min-width: 100%;
  }
  .historial-votos th,
  .historial-votos td {
    text-align: left;
    vertical-align: top;
    padding: var(--espacio-1) var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
  }
  .historial-votos thead th {
    border-bottom-width: var(--foco-ancho);
  }
  .historial-votos p {
    margin: 0;
  }
  .historial-votos td:first-child,
  .historial-votos .voto {
    white-space: nowrap;
  }
  .historial-votos td:nth-child(2) {
    min-width: var(--ancho-nombre-barra);
  }
  .historial-votos tr[hidden] {
    display: none;
  }
</style>
