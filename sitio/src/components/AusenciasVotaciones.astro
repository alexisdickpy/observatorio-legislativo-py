---
// Ausencias en votaciones nominales de un legislador: cantidad con su denominador y lista de las
// votaciones en que figura como AUSENTE, con fecha y sesión, de la más reciente a la más antigua.
// Cada una enlaza a la votación oficial en SILpy. Recibe los valores de lib/legisladores.js.
// Filas en una sola línea y estilos globales con prefijo de clase (ver TablaLegisladores).
import * as rutas from "../lib/rutas.js";
import { textos, fill } from "../lib/contenido.js";
const tx = textos.legisladores.ausencias;
const txc = textos.general.comunes;

interface Props {
  ausencias: any;
  periodo: string;
  camara: string | null;
}
const { ausencias: a, periodo, camara } = Astro.props;
const sinDato = txc.sinDato;
const sesion = (s: any) => [s.numero && `N.º ${s.numero}`, s.tipo].filter(Boolean).join(", ") || sinDato;
---

<div class="ausencias-votaciones">
  <p class="cifra"><strong>{a.texto}</strong></p>
  <p class="chico texto-suave lectura">
    {fill(tx.votacionesNominalesDelPeriodoEn, { periodo: periodo })}
    {camara === "CAMARA DE SENADORES" && tx.elSenadoPublicaMuchasMenos}{" "}
    <a href={rutas.metodologia(rutas.anclasMetodologia.ausencias)}>{txc.comoSeCalcula}</a>
  </p>
  {
    a.lista.length > 0 && (
      <details>
        <summary>{fill(tx.verLasVotacionesEnQue, { lista: a.lista.length })}</summary>
        <div class="historial-desplazable">
          <table>
            <caption class="solo-lectores">{tx.votacionesNominalesEnQueFigura}</caption>
            <thead>
              <tr>
                <th scope="col">{txc.fecha}</th>
                <th scope="col">{tx.sesion}</th>
                <th scope="col">{txc.votacionEnSilpy}</th>
              </tr>
            </thead>
            <tbody data-paginar>
              {a.lista.map((x: any) => <tr data-ausencia><td>{x.fecha ?? sinDato}</td><td>{sesion(x.sesion)}</td><td>{x.url ? <a href={x.url}>{txc.expediente} {x.expediente ?? sinDato}</a> : fill(textos.general.comunes.expedienteNumero, { expediente: x.expediente ?? sinDato })}</td></tr>)}
            </tbody>
          </table>
        </div>
      </details>
    )
  }
</div>

<style is:global>
  .ausencias-votaciones .cifra {
    font-size: var(--tamano-titulo-3);
    margin-bottom: var(--espacio-1);
  }
  .ausencias-votaciones summary {
    cursor: pointer;
  }
  .ausencias-votaciones table {
    margin-top: var(--espacio-2);
    border-collapse: collapse;
    font-size: var(--tamano-chico);
  }
  .ausencias-votaciones th,
  .ausencias-votaciones td {
    text-align: left;
    padding: var(--espacio-1) var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
    white-space: nowrap;
  }
  .ausencias-votaciones thead th {
    border-bottom-width: var(--foco-ancho);
  }
</style>
