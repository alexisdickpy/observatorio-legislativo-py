---
// Ausencias en votaciones nominales de un legislador: cantidad con su denominador y lista de las
// votaciones en que figura como AUSENTE, con fecha y sesión, de la más reciente a la más antigua.
// Cada una enlaza a la votación oficial en SILpy. Recibe los valores de lib/legisladores.js.
// Filas en una sola línea y estilos globales con prefijo de clase (ver TablaLegisladores).
import * as rutas from "../lib/rutas.js";

interface Props {
  ausencias: any;
  periodo: string;
  camara: string | null;
}
const { ausencias: a, periodo, camara } = Astro.props;
const sinDato = "Sin dato";
const sesion = (s: any) => [s.numero && `N.º ${s.numero}`, s.tipo].filter(Boolean).join(", ") || sinDato;
---

<div class="ausencias-votaciones">
  <p class="cifra"><strong>{a.texto}</strong></p>
  <p class="chico texto-suave lectura">
    Votaciones nominales del período {periodo} en que figura como AUSENTE, sobre todas las votaciones
    nominales de su cámara en cuya lista oficial figura, de proyectos de ley y de otros expedientes como
    resoluciones o declaraciones. AUSENTE indica que no registró su voto en esa votación, no que no
    estuviera en la sesión.
    {camara === "CAMARA DE SENADORES" && " El Senado publica muchas menos votaciones nominales que Diputados."}{" "}
    <a href={rutas.metodologia(rutas.anclasMetodologia.ausencias)}>Cómo se calcula</a>
  </p>
  {
    a.lista.length > 0 && (
      <details>
        <summary>Ver las {a.lista.length} votaciones en que figura como AUSENTE</summary>
        <div class="historial-desplazable">
          <table>
            <caption class="solo-lectores">Votaciones nominales en que figura como AUSENTE</caption>
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Sesión</th>
                <th scope="col">Votación en SILpy</th>
              </tr>
            </thead>
            <tbody data-paginar>
              {a.lista.map((x: any) => <tr data-ausencia><td>{x.fecha ?? sinDato}</td><td>{sesion(x.sesion)}</td><td>{x.url ? <a href={x.url}>Expediente {x.expediente ?? sinDato}</a> : `Expediente ${x.expediente ?? sinDato}`}</td></tr>)}
            </tbody>
          </table>
        </div>
      </details>
    )
  }
</div>

<style is:global>
  .ausencias-votaciones .cifra {
    font-size: var(--tamano-titulo-3);
    margin-bottom: var(--espacio-1);
  }
  .ausencias-votaciones summary {
    cursor: pointer;
  }
  .ausencias-votaciones table {
    margin-top: var(--espacio-2);
    border-collapse: collapse;
    font-size: var(--tamano-chico);
  }
  .ausencias-votaciones th,
  .ausencias-votaciones td {
    text-align: left;
    padding: var(--espacio-1) var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
    white-space: nowrap;
  }
  .ausencias-votaciones thead th {
    border-bottom-width: var(--foco-ancho);
  }
</style>
