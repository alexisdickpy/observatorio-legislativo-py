---
// Iniciativa y autores de un registro de ley, tal como los publica el Congreso.
// El nombre de cada autor del período enlaza a su ficha; el de otras legislaturas, a SILpy.
import { clasePartido } from "../lib/partidos.js";
import { legible } from "../lib/texto.js";
import { textos } from "../lib/contenido.js";
const tx = textos.leyes.autores;
const txc = textos.general.comunes;

interface Props {
  detalle: any;
  nivel: number;
}
const { detalle: d, nivel } = Astro.props;
const Titulo = `h${nivel}`;
const sinDato = txc.sinDato;
---

<Titulo>{tx.iniciativaYAutores}</Titulo>
<dl class="iniciativa">
  <div>
    <dt>{tx.iniciativa}</dt>
    <dd class={d.iniciativa ? undefined : "texto-suave"}>{d.iniciativa ?? sinDato}</dd>
  </div>
  {
    d.ministerios.length > 0 && (
      <div>
        <dt>{d.ministerios.length > 1 ? tx.ministeriosAutores : tx.ministerioAutor}</dt>
        <dd>{d.ministerios.join(" · ")}</dd>
      </div>
    )
  }
</dl>
{
  d.autores.length === 0 ? (
    // Sin legisladores autores: si hay ministerio, ya figura arriba como autor del proyecto.
    d.ministerios.length === 0 && <p class="texto-suave">{tx.sinDatoDeAutores}</p>
  ) : (
    <ul class="autores">
      {d.autores.map((a: any) => (
        <li>
          {a.ficha || a.url ? <a href={a.ficha ?? a.url}>{a.nombre ?? sinDato}</a> : <span>{a.nombre ?? sinDato}</span>}
          <span class="chico texto-suave">
             {tx.partido} {a.partido && <span class={`pip ${clasePartido(a.partido)}`}></span>} {legible(a.partido) ?? sinDato}{a.partidoConocido && ` (${a.partidoConocido})`} {tx.bancada} {legible(a.bancada) ?? sinDato} · {a.camara ?? sinDato}
            {!a.delPeriodo && <strong> {tx.legislatura} {a.legislatura ?? sinDato}</strong>}
          </span>
        </li>
      ))}
    </ul>
  )
}
{
  d.autores.some((a: any) => !a.delPeriodo) && (
    <p class="chico texto-suave lectura">
      {tx.algunosAutoresEranLegisladoresDe}
    </p>
  )
}

<style>
  .iniciativa {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3) var(--espacio-5);
  }
  dt {
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  dd {
    margin: 0;
  }
  .autores {
    padding-left: var(--espacio-4);
  }
  .autores li + li {
    margin-top: var(--espacio-1);
  }
</style>
