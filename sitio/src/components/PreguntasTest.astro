---
// Formulario del test de afinidad (#63): el modo y una pregunta por votación, con las opciones A favor,
// En contra y Sin posición. No muestra autores ni votos. Las preguntas que no son del modo básico llevan
// data-avanzada y se ocultan en ese modo (TestAfinidad.astro). Sin JavaScript se ven todas.
import EtiquetasTema from "./EtiquetasTema.astro";
import { MODOS, RESPUESTAS } from "../lib/afinidad.js";

interface Props {
  preguntas: { id: string; pregunta: string; basico: boolean; tema: any }[];
}
const { preguntas } = Astro.props;
const basicas = preguntas.filter((p) => p.basico).length;
---

<form class="test" id="test-afinidad" novalidate>
  <fieldset class="modo">
    <legend>Modo</legend>
    <label><input type="radio" name="modo" value={MODOS.basico.valor} checked /> {MODOS.basico.texto}, {basicas} preguntas</label>
    <label><input type="radio" name="modo" value={MODOS.avanzado.valor} /> {MODOS.avanzado.texto}, {preguntas.length} preguntas</label>
  </fieldset>

  <ol class="preguntas">
    {
      preguntas.map((p, n) => (
        <li data-pregunta={n} data-avanzada={p.basico ? undefined : ""}>
          <fieldset>
            <legend>{p.pregunta}</legend>
            <p class="chico"><EtiquetasTema clasificacion={{ temas: [p.tema], pendiente: false }} /></p>
            <div class="opciones">
              {RESPUESTAS.map((r) => (
                <label>
                  <input type="radio" name={`p-${p.id}`} value={r.valor} />
                  <span>{r.texto}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </li>
      ))
    }
  </ol>

  <div class="acciones">
    <p class="chico texto-suave" data-progreso aria-live="polite"></p>
    <button type="submit">Ver resultado</button>
    <button type="reset" class="secundario">Borrar respuestas</button>
  </div>
</form>

<style>
  .modo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2) var(--espacio-4);
    padding: var(--espacio-3) var(--espacio-4);
    margin: 0 0 var(--espacio-5);
    background: var(--color-superficie);
    border: var(--borde-ancho) solid var(--color-borde);
    border-radius: var(--radio);
  }
  .modo legend {
    font-weight: var(--peso-fuerte);
    padding: 0 var(--espacio-1);
  }
  /* Numeración propia: los marcadores de la lista quedarían fuera de la leyenda. Las ocultas no cuentan. */
  .preguntas {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: pregunta;
  }
  .preguntas li {
    margin-bottom: var(--espacio-5);
    counter-increment: pregunta;
  }
  .preguntas legend::before {
    content: counter(pregunta) ". ";
  }
  .preguntas li[hidden] {
    display: none;
  }
  .preguntas fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .preguntas legend {
    font-weight: var(--peso-fuerte);
    padding: 0;
  }
  .preguntas p {
    margin: var(--espacio-1) 0 var(--espacio-2);
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
  }
  .opciones label {
    cursor: pointer;
  }
  .opciones input {
    position: absolute;
    opacity: 0;
  }
  .opciones span {
    display: inline-block;
    padding: var(--espacio-2) var(--espacio-3);
    border: var(--borde-ancho) solid var(--color-borde);
    border-radius: var(--radio);
    background: var(--color-fondo);
  }
  .opciones input:checked + span {
    background: var(--color-acento);
    border-color: var(--color-acento);
    color: var(--color-sobre-acento);
  }
  .opciones input:focus-visible + span {
    outline: var(--foco-ancho) solid var(--color-foco);
    outline-offset: 2px;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3);
    align-items: center;
  }
  .acciones p {
    flex-basis: 100%;
    margin: 0;
  }
  .acciones button {
    padding: var(--espacio-2) var(--espacio-4);
    font: inherit;
    border-radius: var(--radio);
    border: var(--borde-ancho) solid var(--color-acento);
    background: var(--color-acento);
    color: var(--color-sobre-acento);
    cursor: pointer;
  }
  .acciones button.secundario {
    background: var(--color-fondo);
    color: var(--color-acento);
  }
  .acciones button:focus-visible {
    outline: var(--foco-ancho) solid var(--color-foco);
    outline-offset: 2px;
  }
</style>
