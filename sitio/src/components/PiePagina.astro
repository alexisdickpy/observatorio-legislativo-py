---
// Pie de página común: cita de la fuente con la fecha de actualización, aviso de datos, enlaces a
// las páginas de metodología y privacidad, licencias y firma (textos acordados en #9).
import { actualizacion, cita } from "../lib/catalogo.js";
import * as rutas from "../lib/rutas.js";

const fuente = cita();
const fecha = actualizacion();
const enlaces = [
  { url: rutas.metodologia(), texto: "Metodología" },
  { url: rutas.privacidad(), texto: "Privacidad y aviso legal" },
  { url: rutas.datosAbiertos(), texto: "Datos abiertos" },
  { url: rutas.botTelegram(), texto: "Avisos por Telegram" },
  { url: rutas.codigoFuente(), texto: "Código fuente" },
];
---

<footer class="pie">
  <div class="contenedor chico">
    <p>
      <strong>{fuente.cita}.</strong>
      Actualizado el <time datetime={fecha.iso}>{fecha.texto}</time>.
    </p>
    <p class="lectura">
      Los datos provienen de la API de Datos Abiertos del Congreso Nacional y se muestran tal como allí
      se publican, con sus posibles errores. Este sitio no corrige los valores oficiales. Si un dato
      parece incorrecto, compáralo con la <a href={fuente.url}>fuente oficial</a>. Este es un proyecto
      independiente, sin vínculo con el Congreso.
    </p>
    <nav aria-label="Pie de página">
      <ul class="enlaces">
        {enlaces.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
      </ul>
    </nav>
    <p>
      Datos con licencia <a href={rutas.licenciaDatos()}>{fuente.licencia}</a> · Código con licencia
      <a href={rutas.licenciaCodigo()}>AGPL-3.0</a>
    </p>
    <p class="firma">Desarrollado por Alexis Dick con asistencia de IA.</p>
  </div>
</footer>

<style>
  .pie {
    margin-top: var(--espacio-6);
    border-top: var(--borde-ancho) solid var(--color-borde);
    background: var(--color-superficie);
    padding: var(--espacio-4) 0;
    color: var(--color-texto-suave);
  }
  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2) var(--espacio-4);
    list-style: none;
    padding: 0;
  }
  .firma {
    margin-bottom: 0;
  }
</style>
