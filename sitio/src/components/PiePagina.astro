---
// Pie de página común: cita de la fuente con la fecha de actualización, aviso de datos, enlaces a
// las páginas de metodología y privacidad, licencias y firma (textos acordados en #9).
import { actualizacion, cita } from "../lib/catalogo.js";
import * as rutas from "../lib/rutas.js";
import { textos, md, crudo } from "../lib/contenido.js";
const tx = textos.general.pie;
const txc = textos.general.comunes;

const fuente = cita();
const fecha = actualizacion();
const enlaces = [
  { url: rutas.metodologia(), texto: tx.metodologia },
  { url: rutas.privacidad(), texto: tx.privacidadYAvisoLegal },
  { url: rutas.datosAbiertos(), texto: txc.datosAbiertos },
  { url: rutas.botTelegram(), texto: tx.avisosPorTelegram },
  { url: rutas.codigoFuente(), texto: tx.codigoFuente },
];
---

<footer class="pie">
  <div class="contenedor chico">
    <p set:html={md(tx.actualizadoEl, { cita: fuente.cita, fecha: crudo(`<time datetime="${fecha.iso}">${fecha.texto}</time>`) })} />
    <p class="lectura" set:html={md(tx.losDatosProvienenDeLa, { url1: crudo(fuente.url) })} />
    <nav aria-label={tx.pieDePagina}>
      <ul class="enlaces">
        {enlaces.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
      </ul>
    </nav>
    <p set:html={md(tx.datosConLicenciaCodigoCon, { url1: crudo(rutas.licenciaDatos()), licencia: fuente.licencia, url2: crudo(rutas.licenciaCodigo()) })} />
    <p class="firma">{tx.desarrolladoPorAlexisDickCon}</p>
  </div>
</footer>

<style>
  .pie {
    margin-top: var(--espacio-7);
    border-top: var(--borde-grueso) solid var(--color-texto);
    padding: var(--espacio-4) 0 var(--espacio-5);
    color: var(--color-texto-suave);
  }
  .pie strong {
    color: var(--color-texto);
  }
  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2) var(--espacio-4);
    list-style: none;
    padding: 0;
  }
  .firma {
    margin-bottom: 0;
  }
</style>
