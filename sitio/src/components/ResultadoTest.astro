---
// Resultado del test de afinidad (#63), oculto hasta que se pide. El script calcula la coincidencia con
// lib/afinidad.js a partir de los datos incluidos en la página (lib/testAfinidad.js) y llena las listas.
// No guarda nada ni hace pedidos a ningún servidor.
import { MINIMO_COMPARADAS } from "../lib/afinidad.js";
import * as rutas from "../lib/rutas.js";

interface Props {
  datos: any;
}
const { datos } = Astro.props;
// "<" escapado para que ningún texto pueda cerrar la etiqueta <script>.
const json = JSON.stringify(datos).replace(/</g, "\\u003c");
const camaras = [...new Set(datos.legisladores.map((l: any) => l.camara))];
---

<script type="application/json" id="datos-test-afinidad" set:html={json} />

<section class="resultado" id="resultado-test" tabindex="-1" hidden aria-labelledby="titulo-resultado">
  <h2 id="titulo-resultado">Resultado</h2>
  <p data-resumen></p>
  <p class="chico texto-suave">
    Coincidencia = preguntas en que la posición fue igual a tu respuesta ÷ preguntas comparadas. Con menos de
    {MINIMO_COMPARADAS} preguntas comparadas no se muestra porcentaje. Coincidir no es bueno ni malo.
    <a href={rutas.metodologia(rutas.anclasMetodologia.testAfinidad)}>Cómo se calcula</a>
  </p>

  <h3>Partidos</h3>
  <ol class="lista-afinidad" data-lista="partidos"></ol>

  <h3>Bancadas</h3>
  <ol class="lista-afinidad" data-lista="bancadas"></ol>

  <h3>Legisladores</h3>
  <div class="filtro-camara">
    <label for="camara-afinidad">Cámara</label>
    <select id="camara-afinidad" data-camara>
      <option value="">Las dos</option>
      {camaras.map((c) => <option value={c as string}>{c}</option>)}
    </select>
  </div>
  <ol class="lista-afinidad" data-lista="legisladores"></ol>
  <button type="button" class="ver-todos" data-ver-todos hidden></button>

  <h3>Tus respuestas y las votaciones</h3>
  <ol class="detalle" data-detalle></ol>
</section>

<script>
  import { calcularAfinidad, POSICION, RESPUESTAS } from "../lib/afinidad.js";

  const CANTIDAD_INICIAL = 10;
  const datos = JSON.parse(document.getElementById("datos-test-afinidad")!.textContent!);
  const form = document.getElementById("test-afinidad") as HTMLFormElement;
  const seccion = document.getElementById("resultado-test")!;
  const progreso = form.querySelector<HTMLElement>("[data-progreso]")!;
  const items = [...form.querySelectorAll<HTMLElement>("[data-pregunta]")];
  const selectCamara = seccion.querySelector<HTMLSelectElement>("[data-camara]")!;
  const verTodos = seccion.querySelector<HTMLButtonElement>("[data-ver-todos]")!;
  const textoRespuesta = Object.fromEntries(RESPUESTAS.map((r) => [r.valor, r.texto]));
  const textoPosicion: Record<string, string> = {
    [POSICION.favor]: "A favor",
    [POSICION.contra]: "En contra",
    [POSICION.abstencion]: "Abstención",
    [POSICION.noVota]: "No votó",
    [POSICION.ausente]: "Ausente",
    [POSICION.sinMayoria]: "Sin mayoría a favor o en contra",
    [POSICION.dividido]: "Distinta en cada cámara",
  };
  let todos = false;
  let ultimo: ReturnType<typeof calcularAfinidad> | null = null;

  const modo = () => (form.elements.namedItem("modo") as RadioNodeList).value;
  const respuestas = () =>
    datos.preguntas.map((p: any) => (form.elements.namedItem(`p-${p.id}`) as RadioNodeList).value || undefined);

  function elemento(etiqueta: string, clase?: string, texto?: string) {
    const e = document.createElement(etiqueta);
    if (clase) e.className = clase;
    if (texto !== undefined) e.textContent = texto;
    return e;
  }

  function aplicarModo() {
    const avanzado = modo() === "avanzado";
    for (const li of items) li.hidden = !avanzado && li.hasAttribute("data-avanzada");
    actualizarProgreso();
  }

  function actualizarProgreso() {
    const r = respuestas();
    const visibles = items.filter((li) => !li.hidden).map((li) => Number(li.dataset.pregunta));
    const contestadas = visibles.filter((n) => r[n]).length;
    progreso.textContent = `Respondiste ${contestadas} de ${visibles.length} preguntas.`;
  }

  /** Una fila de una lista: nombre (con enlace si hay), detalle, barra y cifra. */
  function fila(nombre: string, url: string | null, detalle: string | null, c: any) {
    const li = elemento("li");
    const persona = elemento("span", "persona");
    if (url) {
      const a = elemento("a", undefined, nombre) as HTMLAnchorElement;
      a.href = url;
      persona.append(a);
    } else persona.append(elemento("span", undefined, nombre));
    if (detalle) persona.append(elemento("span", "chico texto-suave", detalle));
    const cifra = elemento("strong", "cifra", c.porcentajeTexto ?? "—");
    const sin = c.sinComparar ? ` · ${c.sinComparar} sin comparar` : "";
    const barra = elemento("span", "barra");
    barra.setAttribute("aria-hidden", "true");
    if (c.suficiente) barra.style.setProperty("--ancho", `${Math.round(c.porcentaje * 100)}%`);
    li.append(persona, cifra, barra, elemento("span", "cuenta chico texto-suave", `Coincide en ${c.coinciden} de ${c.comparadas}${sin}`));
    return li;
  }

  function llenar(lista: string, filas: HTMLElement[], vacio: string) {
    const ol = seccion.querySelector<HTMLElement>(`[data-lista="${lista}"]`)!;
    ol.replaceChildren(...(filas.length ? filas : [elemento("li", "texto-suave", vacio)]));
  }

  function mostrarLegisladores() {
    if (!ultimo) return;
    const camara = selectCamara.value;
    const lista = ultimo.legisladores.filter((l: any) => !camara || l.camara === camara);
    const visibles = todos ? lista : lista.slice(0, CANTIDAD_INICIAL);
    llenar(
      "legisladores",
      visibles.map((l: any) => fila(l.nombre, l.ficha, [l.sigla, l.camara].filter(Boolean).join(" · "), l.c)),
      "Ningún legislador con preguntas comparadas.",
    );
    verTodos.hidden = lista.length <= CANTIDAD_INICIAL;
    verTodos.textContent = todos ? "Ver solo los primeros" : `Ver los ${lista.length}`;
  }

  function mostrarDetalle(r: (string | undefined)[], indices: number[]) {
    const ol = seccion.querySelector<HTMLElement>("[data-detalle]")!;
    ol.replaceChildren(
      ...indices.map((n) => {
        const p = datos.preguntas[n];
        const li = elemento("li");
        li.append(elemento("p", "pregunta", p.pregunta));
        li.append(elemento("p", "chico", r[n] ? `Respondiste ${textoRespuesta[r[n]!]}.` : "Sin responder."));
        const enlaces = elemento("p", "chico");
        const ley = elemento("a", undefined, `Ley N° ${p.numeroLey}`) as HTMLAnchorElement;
        ley.href = p.ley;
        enlaces.append(ley);
        for (const v of p.votaciones) {
          enlaces.append(" · ");
          const a = elemento("a", undefined, `Votación, ${v.camara}, ${v.fechaTexto ?? "sin fecha"}`) as HTMLAnchorElement;
          a.href = v.url;
          enlaces.append(a);
        }
        li.append(enlaces);
        const posiciones = datos.partidos
          .filter((x: any) => x.posiciones[n] !== POSICION.noCorresponde)
          .map((x: any) => `${x.sigla ?? x.nombre} ${textoPosicion[x.posiciones[n]].toLowerCase()}`);
        if (posiciones.length) li.append(elemento("p", "chico texto-suave", `Mayoría de cada partido. ${posiciones.join("; ")}.`));
        return li;
      }),
    );
  }

  function calcular() {
    const r = respuestas();
    ultimo = calcularAfinidad(datos, r, modo());
    todos = false;
    const total = ultimo.indices.length;
    seccion.querySelector("[data-resumen]")!.textContent =
      ultimo.respondidas === 0
        ? "No respondiste ninguna pregunta A favor o En contra, así que no hay nada para comparar."
        : `Respondiste A favor o En contra ${ultimo.respondidas} de ${total} preguntas. Esas son las que se comparan.`;
    llenar("partidos", ultimo.partidos.map((x: any) => fila(x.conocido ? `${x.nombre} (${x.conocido})` : x.nombre, null, x.sigla, x.c)), "Ningún partido con preguntas comparadas.");
    llenar("bancadas", ultimo.bancadas.map((x: any) => fila(x.nombre, null, x.camara, x.c)), "Ninguna bancada con preguntas comparadas.");
    mostrarLegisladores();
    mostrarDetalle(r, ultimo.indices);
    seccion.hidden = false;
    seccion.focus();
  }

  form.addEventListener("change", (e) => {
    if ((e.target as HTMLInputElement).name === "modo") aplicarModo();
    else actualizarProgreso();
  });
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    calcular();
  });
  form.addEventListener("reset", () => {
    seccion.hidden = true;
    ultimo = null;
    setTimeout(aplicarModo);
  });
  selectCamara.addEventListener("change", mostrarLegisladores);
  verTodos.addEventListener("click", () => {
    todos = !todos;
    mostrarLegisladores();
  });
  aplicarModo();
</script>

<style>
  .resultado {
    margin-top: var(--espacio-6);
    padding-top: var(--espacio-4);
    border-top: var(--borde-ancho) solid var(--color-borde);
  }
  .resultado:focus {
    outline: none;
  }
  .lista-afinidad {
    max-width: var(--ancho-lectura);
    list-style: none;
    margin: 0 0 var(--espacio-5);
    padding: 0;
  }
  .lista-afinidad :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--espacio-1) var(--espacio-3);
    padding: var(--espacio-2) 0;
    border-bottom: var(--borde-ancho) solid var(--color-borde);
  }
  .lista-afinidad :global(.persona) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .lista-afinidad :global(.cifra) {
    text-align: right;
  }
  .lista-afinidad :global(.cuenta) {
    grid-column: 1 / -1;
  }
  .lista-afinidad :global(.barra) {
    grid-column: 1 / -1;
    grid-row: 2;
    height: 0.375rem;
    background: var(--color-superficie);
    border-radius: var(--radio);
    overflow: hidden;
  }
  .lista-afinidad :global(.barra)::before {
    content: "";
    display: block;
    height: 100%;
    width: var(--ancho, 0);
    background: var(--color-acento);
  }
  .filtro-camara {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
    align-items: center;
    margin-bottom: var(--espacio-3);
  }
  .filtro-camara select {
    max-width: 100%;
  }
  .ver-todos {
    padding: var(--espacio-2) var(--espacio-4);
    font: inherit;
    border-radius: var(--radio);
    border: var(--borde-ancho) solid var(--color-acento);
    background: var(--color-fondo);
    color: var(--color-acento);
    cursor: pointer;
    margin-bottom: var(--espacio-5);
  }
  .ver-todos[hidden] {
    display: none;
  }
  .detalle {
    padding-left: var(--espacio-5);
  }
  .detalle :global(li) {
    margin-bottom: var(--espacio-4);
  }
  .detalle :global(p) {
    margin: 0 0 var(--espacio-1);
  }
  .detalle :global(.pregunta) {
    font-weight: var(--peso-fuerte);
  }
</style>
