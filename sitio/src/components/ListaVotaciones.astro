---
// Lista de votaciones nominales (alcance acordado en #44), en el orden recibido. Cada una con fecha,
// cámara, etapa, proyecto con su título oficial completo (enlace a la ficha de la ley, o al expediente
// oficial si no llegó a ser ley), estado oficial del proyecto, resultado oficial, totales con su
// denominador, barra y posición de cada partido. El enlace de la ley lleva a la votación en su ficha; sin ley, se agrega el enlace a la
// votación en SILpy. Cada elemento lleva sus valores de filtro (componente FiltroVotaciones). Con
// `diferencia`, también la diferencia entre SI y NO (votaciones más ajustadas).
// Recibe las votaciones de lib/votaciones.js. Títulos oficiales en <span class="titulo">, como en las
// demás páginas. Elementos en una sola línea por el peso de la página (compressHTML desactivado).
import BarraVotos from "./BarraVotos.astro";
import PosicionPartidos from "./PosicionPartidos.astro";

interface Props {
  votaciones: any[];
  diferencia?: boolean;
}
const { votaciones, diferencia = false } = Astro.props;
const sinDato = "Sin dato";
const proyecto = (v: any) =>
  v.leyes.length
    ? v.leyes.map((l: any) => ({ url: l.url, texto: `Ley ${l.numero}`, titulo: l.titulo }))
    : [{ url: v.proyecto.url, texto: `Expediente ${v.proyecto.expediente ?? sinDato}`, titulo: v.proyecto.titulo }];
---

<ol class="lista-votaciones">
  {votaciones.map((v) => <li data-votacion={v.id} data-camara={v.camaraFiltro} data-estado={v.proyecto.estadoFiltro} data-resultado={v.resultadoFiltro}><p class="chico texto-suave">{v.fecha ?? sinDato} · {v.camara ?? sinDato} · {v.etapa ?? sinDato}</p><p class="proyecto">{proyecto(v).map((p: any) => <span>{p.url ? <a href={p.url}>{p.texto}</a> : p.texto}{p.titulo && <span class="titulo texto-suave"> {p.titulo}</span>} </span>)}</p><p class="chico">Estado del proyecto <strong>{v.proyecto.estado ?? sinDato}</strong> · Resultado <strong>{v.resultado ?? sinDato}</strong>{diferencia && <span> · Diferencia entre SI y NO <strong>{v.diferencia}</strong></span>}</p><p class="chico">{v.totales.map((t: any) => `${t.categoria} ${t.cantidad}`).join(" · ")} <span class="texto-suave">(de {v.registrados} legisladores registrados)</span></p><BarraVotos barra={v.barra} compacta /><PosicionPartidos partidos={v.partidos} />{!v.leyes.length && <p class="chico"><a href={v.url}>Votación en SILpy</a></p>}</li>)}
</ol>

<style is:global>
  .lista-votaciones {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lista-votaciones > li {
    display: grid;
    gap: var(--espacio-2);
    padding: var(--espacio-3) 0;
    border-top: var(--borde-ancho) solid var(--color-borde);
  }
  .lista-votaciones > li[hidden] {
    display: none;
  }
  .lista-votaciones p {
    margin: 0;
  }
  .lista-votaciones .proyecto {
    overflow-wrap: anywhere;
  }
</style>
