---
// Comisiones de las que un legislador figura como miembro en cada período parlamentario, con su tipo y
// enlace a SILpy. Recibe los valores de lib/comisiones.js. Estilos globales con prefijo de clase. El nombre
// oficial va en <span class="titulo-…">, como los títulos oficiales, para que las pruebas de textos propios
// no lo revisen (hay una comisión de «Asistencia, protección y bienestar animal»).
import * as rutas from "../lib/rutas.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.legisladores.comisiones;
const txc = textos.general.comunes;

interface Props {
  comisiones: any;
  periodo: string;
}
const { comisiones: c, periodo } = Astro.props;
const sinDato = txc.sinDato;
---

<div class="comisiones-legislador">
  {
    c.total === 0 ? (
      <p class="lectura">{fill(tx.noFiguraComoMiembroDe, { periodo: periodo })}</p>
    ) : (
      c.periodos.map((p: any) => (
        <section aria-label={fill(tx.periodoParlamentarioDe, { nombre: p.nombre ?? sinDato })}>
          <p class="comisiones-periodo">{tx.periodoParlamentario} {p.nombre ?? sinDato} ({p.comisiones.length})</p>
          <ul>
            {p.comisiones.map((x: any) => (
              <li>
                {x.url ? <a href={x.url}><span class="titulo-comision">{x.nombre ?? sinDato}</span></a> : <span class="titulo-comision">{x.nombre ?? sinDato}</span>}
                <span class="texto-suave chico"> · {x.tipo ?? sinDato}</span>
                {x.nota && <span class="nota chico texto-suave">{x.nota}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
  <p class="chico texto-suave lectura" set:html={md(tx.segunLasListasDeMiembros, { url1: crudo(rutas.metodologia(rutas.anclasMetodologia.comisiones)) })} />
</div>

<style is:global>
  .comisiones-legislador .comisiones-periodo {
    font-weight: bold;
    margin-bottom: var(--espacio-1);
  }
  .comisiones-legislador ul {
    margin-top: 0;
    margin-bottom: var(--espacio-4);
  }
  .comisiones-legislador li {
    margin-bottom: var(--espacio-1);
  }
  .comisiones-legislador .nota {
    display: block;
  }
</style>
