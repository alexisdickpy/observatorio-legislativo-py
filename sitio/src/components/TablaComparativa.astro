---
// Tabla de la vista comparativa de una cámara: por legislador, sus ausencias, NO VOTA y abstenciones
// en votaciones nominales y sus votos distintos a la mayoría de su bancada y de su partido, cada cifra
// por separado con su denominador. Sin votaciones comparables, dice por qué. Recibe las filas de
// lib/legisladores.js (comparativa). Los atributos data-* los usa OrdenComparativa para reordenar.
// Filas en una sola línea y estilos globales con prefijo de clase (ver TablaLegisladores).
import { CIFRAS_COMPARATIVAS, CIFRAS_MAYORIA } from "../lib/legisladores.js";
import { textos } from "../lib/contenido.js";
const tx = textos.legisladores.tablaComparativa;
const txc = textos.general.comunes;

interface Props {
  titulo: string;
  filas: any[];
}
const { titulo, filas } = Astro.props;
const sinDato = txc.sinDato;
const sinGrupo = { bancada: tx.sinBancadaRegistrada, partido: txc.sinPartidoRegistrado };
/** Texto de una cifra de mayoría: la proporción, o el motivo por el que no hay votaciones comparables. */
const textoMayoria = (c: any, grupo: "bancada" | "partido") =>
  !c.grupo ? sinGrupo[grupo] : c.total ? c.texto : tx.sinVotacionesComparables;
/** Porcentaje para ordenar; -1 deja al final a quien no tiene votaciones comparables. */
const ordenMayoria = (c: any) => (c.total ? c.porcentaje : -1);
---

<div class="tabla-comparativa-desplazable">
  <table class="tabla-comparativa">
    <caption class="solo-lectores">{titulo}</caption>
    <thead>
      <tr>
        <th scope="col">{txc.nombre}</th>
        <th scope="col">{tx.votacionesEnSuLista}</th>
        {CIFRAS_COMPARATIVAS.map((c) => <th scope="col">{c.titulo}</th>)}
        {CIFRAS_MAYORIA.map((c) => <th scope="col">{c.titulo}</th>)}
      </tr>
    </thead>
    <tbody data-paginar>
      {filas.map((f, n) => <tr data-comparativa data-slug={f.slug} data-posicion={n} data-ausencias={f.ausencias.porcentaje} data-no-vota={f.noVota.porcentaje} data-abstencion={f.abstencion.porcentaje} data-mayoria-bancada={ordenMayoria(f.mayoriaBancada)} data-mayoria-partido={ordenMayoria(f.mayoriaPartido)}><th scope="row"><a href={f.url}>{f.nombre ?? sinDato}</a>{!f.vigente && <span class="chico texto-suave"> {tx.yaNoEjerce}</span>}</th><td data-etiqueta={tx.votacionesEnSuLista}>{f.ausencias.total.toLocaleString("es-PY")}</td>{CIFRAS_COMPARATIVAS.map((c) => <td data-etiqueta={c.titulo}>{f[c.campo].texto}</td>)}{CIFRAS_MAYORIA.map((c) => <td data-etiqueta={c.titulo}>{textoMayoria(f[c.campo], c.grupo)}</td>)}</tr>)}
    </tbody>
  </table>
</div>

<style is:global>
  .tabla-comparativa-desplazable {
    overflow-x: auto;
  }
  .tabla-comparativa {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--tamano-chico);
  }
  .tabla-comparativa th,
  .tabla-comparativa td {
    text-align: left;
    vertical-align: top;
    padding: var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
  }
  .tabla-comparativa td {
    white-space: nowrap;
  }
  .tabla-comparativa thead th {
    border-bottom-width: var(--foco-ancho);
  }
  .tabla-comparativa tbody th {
    font-weight: var(--peso-normal);
  }

  /* Móvil: cada legislador como una tarjeta. 48rem = --punto-quiebre-movil. */
  @media (max-width: 48rem) {
    .tabla-comparativa thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .tabla-comparativa tr,
    .tabla-comparativa th,
    .tabla-comparativa td {
      display: block;
    }
    .tabla-comparativa tbody tr {
      border-bottom: var(--borde-ancho) solid var(--color-borde);
      padding: var(--espacio-3) 0;
    }
    .tabla-comparativa tbody th,
    .tabla-comparativa tbody td {
      border: 0;
      padding: var(--espacio-1) 0;
      white-space: normal;
    }
    .tabla-comparativa tbody th {
      font-size: var(--tamano-base);
    }
    .tabla-comparativa tbody td::before {
      content: attr(data-etiqueta) " ";
      color: var(--color-texto-suave);
    }
  }
</style>
