---
// Reparto de los votos de cada partido o bancada en las votaciones de un tema (lib/votosPorTema.js,
// #37): por grupo, su nombre, la barra de colores y cada categoría con votos, con su denominador. Recibe
// los valores ya calculados. Los partidos llevan la sigla propia y, entre paréntesis, el nombre conocido.
import BarraVotos from "./BarraVotos.astro";

interface Props {
  titulo: string;
  categorias: string[];
  filas: any[];
}
const { titulo, categorias, filas } = Astro.props;
---

<div class="reparto-tema">
  <h4>{titulo}</h4>
  <ul>
    {filas.map((f) => <li><p class="nombre chico">{f.sigla && f.sigla !== f.texto && <b>{f.sigla} </b>}{f.texto}{f.nombreConocido && <span class="texto-suave"> ({f.nombreConocido})</span>}</p><BarraVotos barra={f.barra} /><p class="cifras chico">{categorias.map((c, n) => f.celdas[n].cantidad > 0 && <span><b>{c}</b> {f.celdas[n].texto}</span>)}</p></li>)}
  </ul>
</div>

<style is:global>
  .reparto-tema ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .reparto-tema li {
    display: grid;
    gap: var(--espacio-1);
    padding: var(--espacio-3) 0;
    border-top: var(--borde-ancho) solid var(--color-borde);
  }
  .reparto-tema p {
    margin: 0;
  }
  .reparto-tema .cifras {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1) var(--espacio-4);
  }
</style>
