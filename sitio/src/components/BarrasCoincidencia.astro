---
// Gráfico de barras de la portada: la coincidencia de cada partido de una cámara con el de más
// legisladores en ejercicio (lib/portada.js, barrasDeReferencia). Cada barra con el color de su partido
// y el porcentaje con sus cantidades siempre a la vista. Sin porcentaje (pocas votaciones
// en común), solo las cantidades y sin barra.
interface Props {
  referencia: string;
  barras: any[];
}
import { clasePartido } from "../lib/partidos.js";
import { legible } from "../lib/texto.js";
import { textos, fill } from "../lib/contenido.js";
const tx = textos.portada.barrasCoincidencia;

const { referencia, barras } = Astro.props;
---

<figure class="barras-coincidencia">
  <figcaption class="chico texto-suave">{fill(tx.votacionesEnQueCadaPartido, { referencia: referencia })}</figcaption>
  <ul>
    {
      barras.map((b) => (
        <li>
          <span class="encabezado chico">
            <span><span class={`pip ${clasePartido(b.nombre)}`}></span> {legible(b.nombre)}</span>
            {b.suficiente ? (
              <span class="valor">
                <strong>{b.porcentajeTexto}</strong> <span class="texto-suave">{b.fraccion}</span>
              </span>
            ) : (
              <span class="valor texto-suave">{fill(tx.sin, { fraccion: b.fraccion })}</span>
            )}
          </span>
          {b.suficiente && (
            <span class="pista" aria-hidden="true">
              <span class={`relleno ${clasePartido(b.nombre)}`} style={`--porcentaje: ${b.porcentaje}`} />
            </span>
          )}
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .barras-coincidencia {
    margin: var(--espacio-3) 0;
  }
  ul {
    list-style: none;
    margin: var(--espacio-2) 0 0;
    padding: 0;
  }
  li + li {
    margin-top: var(--espacio-2);
  }
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--espacio-2);
  }
  .pista {
    display: block;
    height: var(--alto-barra-fina);
    background: var(--color-superficie);
    overflow: hidden;
  }
  .relleno {
    display: block;
    height: 100%;
    width: calc(var(--porcentaje) * 100%);
    background: var(--color-partido);
    box-shadow: inset 0 0 0 var(--borde-ancho) var(--borde-partido, transparent);
  }
  .valor {
    white-space: nowrap;
  }
</style>
