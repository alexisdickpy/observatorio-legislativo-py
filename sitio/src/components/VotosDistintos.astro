---
// Votos distintos a la mayoría de su bancada y de su partido en votaciones nominales: dos cifras
// separadas, cada una con su denominador, y la lista de las votaciones en que votó distinto a una u otra
// mayoría, de la más reciente a la más antigua. Cada una enlaza a la votación oficial en SILpy. Recibe el
// bloque mayoria de lib/legisladores.js (ficha). Votar distinto no se califica.
// Filas en una sola línea y estilos globales con prefijo de clase (ver TablaLegisladores).
import { GRUPOS_MAYORIA } from "../lib/legisladores.js";
import * as rutas from "../lib/rutas.js";

interface Props {
  mayoria: any;
  periodo: string;
}
const { mayoria: m, periodo } = Astro.props;
const sinDato = "Sin dato";
const titulos: Record<string, string> = { bancada: "De su bancada", partido: "De su partido" };
const sinGrupo: Record<string, string> = { bancada: "Sin bancada registrada", partido: "Sin partido registrado" };
/** Cifra de un grupo, o el motivo por el que no hay votaciones comparables. */
const cifra = (c: any, grupo: string) => (!c.grupo ? sinGrupo[grupo] : c.total ? c.texto : "Sin votaciones comparables");
/** Votaciones de un grupo que quedan fuera del cálculo, si las hay. */
const excluidas = (c: any) =>
  [c.empates && `${c.empates.toLocaleString("es-PY")} con empate`, c.unico && `${c.unico.toLocaleString("es-PY")} en que fue el único votante del grupo`]
    .filter(Boolean)
    .join(" y ");
/** Celda de la mayoría de un grupo en una votación de la lista. */
const celda = (x: any) =>
  ({ empate: "Empate", unico: "Único votante", "sin-grupo": sinDato })[x.estado as string] ?? x.mayoria;
---

<div class="votos-distintos">
  <dl>
    {
      GRUPOS_MAYORIA.map(({ grupo }) => (
        <div>
          <dt>{titulos[grupo]}</dt>
          <dd><strong>{cifra(m[grupo], grupo)}</strong></dd>
          {m[grupo].grupo && excluidas(m[grupo]) && <dd class="chico texto-suave">Sin contar {excluidas(m[grupo])}</dd>}
        </div>
      ))
    }
  </dl>
  <p class="chico texto-suave lectura">
    Votaciones nominales del período {periodo} en que su voto fue distinto a la categoría más votada por
    los miembros de su bancada, o de su partido, que emitieron voto, sobre las votaciones en que emitió voto
    y su grupo tuvo una mayoría. No cuentan los empates, las votaciones en que fue el único de su grupo que
    votó, ni AUSENTE y NO VOTA. Votar distinto no es bueno ni malo.{" "}
    <a href={rutas.metodologia(rutas.anclasMetodologia.mayoria)}>Cómo se calcula</a>
    {" · "}
    <a href={rutas.votacionesNominales()}>Comparar con los demás legisladores</a>
  </p>
  {
    m.lista.length > 0 && (
      <details>
        <summary>Ver las {m.lista.length} votaciones en que votó distinto a una de las dos mayorías</summary>
        <div class="historial-desplazable">
          <table>
            <caption class="solo-lectores">Votaciones nominales en que votó distinto a la mayoría de su bancada o de su partido</caption>
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Votación en SILpy</th>
                <th scope="col">Etapa</th>
                <th scope="col">Su voto</th>
                <th scope="col">Mayoría de su bancada</th>
                <th scope="col">Mayoría de su partido</th>
              </tr>
            </thead>
            <tbody data-paginar>
              {m.lista.map((x: any) => <tr data-distinto><td>{x.fecha ?? sinDato}</td><td>{x.url ? <a href={x.url}>Expediente {x.expediente ?? sinDato}</a> : `Expediente ${x.expediente ?? sinDato}`}</td><td>{x.etapa ?? sinDato}</td><td>{x.sentido}</td><td class={x.bancada.estado === "distinto" ? "distinto" : undefined}>{celda(x.bancada)}</td><td class={x.partido.estado === "distinto" ? "distinto" : undefined}>{celda(x.partido)}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="chico texto-suave">En negrita, la mayoría de la que difiere su voto.</p>
      </details>
    )
  }
</div>

<style is:global>
  .votos-distintos dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3) var(--espacio-5);
    margin: 0 0 var(--espacio-1);
  }
  .votos-distintos dt {
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  .votos-distintos dd {
    margin: 0;
  }
  .votos-distintos dd strong {
    font-size: var(--tamano-titulo-3);
  }
  .votos-distintos summary {
    cursor: pointer;
  }
  .votos-distintos table {
    margin-top: var(--espacio-2);
    border-collapse: collapse;
    font-size: var(--tamano-chico);
  }
  .votos-distintos th,
  .votos-distintos td {
    text-align: left;
    padding: var(--espacio-1) var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
    white-space: nowrap;
  }
  .votos-distintos thead th {
    border-bottom-width: var(--foco-ancho);
  }
  .votos-distintos .distinto {
    font-weight: var(--peso-fuerte);
  }
</style>
