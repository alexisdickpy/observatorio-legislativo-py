---
// Votos distintos a la mayoría de su bancada y de su partido en votaciones nominales: dos cifras
// separadas, cada una con su denominador, y la lista de las votaciones en que votó distinto a una u otra
// mayoría, de la más reciente a la más antigua. Cada una enlaza a la votación oficial en SILpy. Recibe el
// bloque mayoria de lib/legisladores.js (ficha). Votar distinto no se califica.
// Filas en una sola línea y estilos globales con prefijo de clase (ver TablaLegisladores).
import { GRUPOS_MAYORIA } from "../lib/legisladores.js";
import * as rutas from "../lib/rutas.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.legisladores.votosDistintos;
const txc = textos.general.comunes;

interface Props {
  mayoria: any;
  periodo: string;
}
const { mayoria: m, periodo } = Astro.props;
const sinDato = txc.sinDato;
const titulos: Record<string, string> = { bancada: tx.deSuBancada, partido: tx.deSuPartido };
const sinGrupo: Record<string, string> = { bancada: tx.sinBancadaRegistrada, partido: txc.sinPartidoRegistrado };
/** Cifra de un grupo, o el motivo por el que no hay votaciones comparables. */
const cifra = (c: any, grupo: string) => (!c.grupo ? sinGrupo[grupo] : c.total ? c.texto : tx.sinVotacionesComparables);
/** Votaciones de un grupo que quedan fuera del cálculo, si las hay. */
const excluidas = (c: any) =>
  [c.empates && fill(tx.conEmpateCantidad, { cantidad: c.empates.toLocaleString("es-PY") }), c.unico && fill(tx.unicoVotanteCantidad, { cantidad: c.unico.toLocaleString("es-PY") })]
    .filter(Boolean)
    .join(" y ");
/** Celda de la mayoría de un grupo en una votación de la lista. */
const celda = (x: any) =>
  ({ empate: tx.empate, unico: tx.unicoVotante, "sin-grupo": sinDato })[x.estado as string] ?? x.mayoria;
---

<div class="votos-distintos">
  <dl>
    {
      GRUPOS_MAYORIA.map(({ grupo }) => (
        <div>
          <dt>{titulos[grupo]}</dt>
          <dd><strong>{cifra(m[grupo], grupo)}</strong></dd>
          {m[grupo].grupo && excluidas(m[grupo]) && <dd class="chico texto-suave">{fill(tx.sinContar, { grupo: excluidas(m[grupo]) })}</dd>}
        </div>
      ))
    }
  </dl>
  <p class="chico texto-suave lectura" set:html={md(tx.votacionesNominalesDelPeriodoEn, { periodo: periodo, url1: crudo(rutas.metodologia(rutas.anclasMetodologia.mayoria)), url2: crudo(rutas.votacionesNominales()) })} />
  {
    m.lista.length > 0 && (
      <details>
        <summary>{fill(tx.verLasVotacionesEnQue, { lista: m.lista.length })}</summary>
        <div class="historial-desplazable">
          <table>
            <caption class="solo-lectores">{tx.votacionesNominalesEnQueVoto}</caption>
            <thead>
              <tr>
                <th scope="col">{txc.fecha}</th>
                <th scope="col">{txc.votacionEnSilpy}</th>
                <th scope="col">{tx.etapa}</th>
                <th scope="col">{tx.suVoto}</th>
                <th scope="col">{tx.mayoriaDeSuBancada}</th>
                <th scope="col">{tx.mayoriaDeSuPartido}</th>
              </tr>
            </thead>
            <tbody data-paginar>
              {m.lista.map((x: any) => <tr data-distinto><td>{x.fecha ?? sinDato}</td><td>{x.url ? <a href={x.url}>{txc.expediente} {x.expediente ?? sinDato}</a> : fill(textos.general.comunes.expedienteNumero, { expediente: x.expediente ?? sinDato })}</td><td>{x.etapa ?? sinDato}</td><td>{x.sentido}</td><td class={x.bancada.estado === "distinto" ? "distinto" : undefined}>{celda(x.bancada)}</td><td class={x.partido.estado === "distinto" ? "distinto" : undefined}>{celda(x.partido)}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="chico texto-suave">{tx.enNegritaLaMayoriaDe}</p>
      </details>
    )
  }
</div>

<style is:global>
  .votos-distintos dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3) var(--espacio-5);
    margin: 0 0 var(--espacio-1);
  }
  .votos-distintos dt {
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  .votos-distintos dd {
    margin: 0;
  }
  .votos-distintos dd strong {
    font-size: var(--tamano-titulo-3);
  }
  .votos-distintos summary {
    cursor: pointer;
  }
  .votos-distintos table {
    margin-top: var(--espacio-2);
    border-collapse: collapse;
    font-size: var(--tamano-chico);
  }
  .votos-distintos th,
  .votos-distintos td {
    text-align: left;
    padding: var(--espacio-1) var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
    white-space: nowrap;
  }
  .votos-distintos thead th {
    border-bottom-width: var(--foco-ancho);
  }
  .votos-distintos .distinto {
    font-weight: var(--peso-fuerte);
  }
</style>
