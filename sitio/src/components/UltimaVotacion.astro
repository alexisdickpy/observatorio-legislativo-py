---
// Titular de la portada (#80): la votación nominal más reciente sobre un proyecto de ley, con su
// resultado oficial grande, el hemiciclo y el voto de cada partido. Datos de lib/portada.js.
import Hemiciclo from "./Hemiciclo.astro";
import { votacionDestacada } from "../lib/portada.js";
import * as rutas from "../lib/rutas.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.portada.ultimaVotacion;
const txc = textos.general.comunes;

interface Props {
  periodo: string;
}
const { periodo } = Astro.props;
const v = votacionDestacada(periodo);
const sinDato = txc.sinDato;
---

{
  v && (
    <section class="ultima" aria-labelledby="titulo-ultima">
      <p class="antetitulo">
        {tx.ultimaVotacionNominal} {v.camara ?? sinDato} · <time datetime={v.fechaIso}>{v.fecha ?? sinDato}</time>
      </p>
      <div class="columnas">
        <div class="relato">
          <h2 id="titulo-ultima" class="veredicto">{v.resultado ?? sinDato}</h2>
          <p class="titulo-proyecto">
            <a href={v.pagina}>{v.titulo}</a>
          </p>
          <p class="chico texto-suave">
            {v.etapa ?? sinDato} {tx.expediente} {v.expediente ?? sinDato}{v.ley && <Fragment> · <a href={rutas.ley(v.ley.numero)}>{fill(tx.ley, { numero: v.ley.numero })}</a></Fragment>}
          </p>
        </div>
        <figure class="plenario">
          <Hemiciclo puntos={v.asientos} cifra={`${v.si} – ${v.no}`} detalle="SI – NO" etiqueta={fill(tx.hemicicloCon, { registrados: v.registrados, leyenda: v.leyenda.map((l) => `${l.categoria} ${l.cantidad}`).join(", ") })} />
          <figcaption>
            <ul class="leyenda">
              {v.leyenda.map((l) => <li><span class={`punto ${l.clase}`}></span>{l.categoria} <strong>{l.cantidad}</strong></li>)}
            </ul>
            <p class="chico texto-suave">{tx.unPuntoPorLegisladorAgrupados}</p>
          </figcaption>
        </figure>
      </div>
      {
        !v.totalesCoinciden && (
          <p class="chico lectura">
            <strong>{tx.notaDelObservatorio}</strong> {tx.losTotalesPublicadosNoCoinciden}{v.recalculados.map((r) => `${r.categoria} ${r.cantidad}`).join(" · ")}).
          </p>
        )
      }
      <table class="por-partido">
        <caption class="solo-lectores">{tx.votoDeCadaPartidoEn}</caption>
        <tbody>
          {
            v.partidos.map((p) => (
              <tr>
                <th scope="row" title={p.nombre ?? undefined}><span class={`pip ${p.clase}`}></span> {p.sigla}</th>
                <td class="puntos" aria-hidden="true">{p.puntos.map((x) => <span class={`punto ${x.clase}`} title={x.titulo}></span>)}</td>
                <td class="resumen">{p.resumen.map((c) => `${c.cantidad} ${c.categoria}`).join(" · ")}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p set:html={md(tx.verComoVotoCadaLegislador, { url1: crudo(v.pagina) })} />
    </section>
  )
}

<style>
  .ultima {
    border-top: var(--borde-ancho) solid var(--color-borde-fuerte);
    padding-top: var(--espacio-3);
  }
  .antetitulo {
    font-size: var(--tamano-chico);
    letter-spacing: 0.03em;
    color: var(--color-texto-suave);
    margin-bottom: var(--espacio-4);
  }
  .columnas {
    display: grid;
    gap: var(--espacio-5) var(--espacio-6);
  }
  .veredicto {
    font-size: var(--tamano-veredicto);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 var(--espacio-4);
    overflow-wrap: anywhere;
  }
  .titulo-proyecto {
    font-family: var(--fuente-titulo);
    font-size: var(--tamano-titulo-3);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .titulo-proyecto a,
  .titulo-proyecto a:visited {
    color: var(--color-texto);
    text-decoration-color: var(--color-borde-fuerte);
  }
  .plenario {
    margin: 0;
  }
  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1) var(--espacio-4);
    list-style: none;
    padding: 0;
    margin: var(--espacio-3) 0 var(--espacio-2);
    font-size: var(--tamano-chico);
  }
  .leyenda .punto {
    margin-right: var(--espacio-2);
    vertical-align: -0.05em;
  }
  .por-partido {
    width: 100%;
    margin: var(--espacio-5) 0 var(--espacio-4);
    border-collapse: collapse;
    font-size: var(--tamano-chico);
  }
  .por-partido tr {
    border-top: var(--borde-ancho) solid var(--color-borde);
  }
  .por-partido tr:last-child {
    border-bottom: var(--borde-ancho) solid var(--color-borde);
  }
  .por-partido th,
  .por-partido td {
    padding: var(--espacio-2) var(--espacio-3) var(--espacio-2) 0;
    text-align: left;
    vertical-align: baseline;
  }
  .por-partido th {
    font-weight: var(--peso-fuerte);
    white-space: nowrap;
  }
  .puntos {
    line-height: 1;
  }
  .puntos .punto {
    margin: 0 0.2rem 0.2rem 0;
  }
  .resumen {
    color: var(--color-texto-suave);
    padding-right: 0;
    text-align: right;
  }
  .por-partido .resumen {
    text-align: right;
    padding-right: 0;
  }
  @media (min-width: 60rem) {
    .columnas {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
    .plenario {
      max-width: 42rem;
      justify-self: end;
      width: 100%;
    }
  }
  /* En el celular cada partido ocupa dos líneas: sigla y resumen arriba, los puntos abajo. */
  @media (max-width: 40rem) {
    .por-partido tr {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0 var(--espacio-3);
      padding: var(--espacio-2) 0;
    }
    .por-partido th,
    .por-partido td {
      padding: 0;
    }
    .puntos {
      grid-row: 2;
      grid-column: 1 / -1;
      padding-top: var(--espacio-2) !important;
    }
  }
</style>
