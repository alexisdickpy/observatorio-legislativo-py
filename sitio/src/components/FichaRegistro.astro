---
// Un registro oficial de ley: valores tal como los publica el Congreso, con su iniciativa,
// autores y votaciones (preparados por lib/ficha.js).
import { decisionesDeProyecto } from "../lib/decisiones.js";
import Autores from "./Autores.astro";
import Votaciones from "./Votaciones.astro";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.leyes.registro;
const txc = textos.general.comunes;

interface Props {
  registro: any;
  detalle: any;
  encabezado: string | null;
}
const { registro: r, detalle, encabezado } = Astro.props;
const sinDato = txc.sinDato;
const decisiones = decisionesDeProyecto(r.periodo, r.idProyecto);
const nivel = encabezado ? 3 : 2;
const Subtitulo = `h${nivel}`;
const datos = [
  [tx.fechaDeSancion, r.fechaSancion],
  [tx.fechaDePromulgacion, r.fechaPromulgacion],
  [tx.fechaDePublicacion, r.fechaPublicacion],
  [tx.tipoDePromulgacion, r.tipoPromulgacion],
  [tx.observacionDelDecreto, r.observacionDecreto],
  [txc.camaraDeOrigen, r.camaraOrigen],
  [txc.expediente, r.expediente],
  [txc.estadoDelProyecto, r.estadoProyecto],
];
---

<section class="registro">
  {encabezado && <h2>{encabezado}</h2>}
  <p class="titulo lectura">{r.titulo ?? sinDato}</p>
  <dl>
    {
      datos.map(([nombre, valor]) => (
        <div>
          <dt>{nombre}</dt>
          <dd class={valor ? undefined : "texto-suave"}>{valor || sinDato}</dd>
        </div>
      ))
    }
  </dl>
  {detalle.notas.map((n: string) => <p class="nota chico lectura" set:html={md(tx.notaDelObservatorio, { valor: n })} />)}
  {
    detalle.conNombreConocido && (
      <p class="chico texto-suave lectura">
        {tx.entreParentesisElNombrePor}
      </p>
    )
  }
  <Autores detalle={detalle} nivel={nivel} />
  <Subtitulo>{tx.enlacesOficiales}</Subtitulo>
  <ul>
    {r.urlLey && <li set:html={md(tx.fichaDeLaLeyEn, { url1: crudo(r.urlLey) })} />}
    {r.urlExpediente && <li set:html={md(tx.expedienteEnSilpy, { url1: crudo(r.urlExpediente) })} />}
    {
      r.textosDeLey.map((t: any) => (
        <li>
          <a href={t.url}>{fill(tx.textoDeLaLey, { descripcion: t.descripcion })}{t.formato === "application/pdf" ? ", PDF" : ""})</a>
        </li>
      ))
    }
  </ul>
  <Votaciones votaciones={detalle.votaciones} periodo={detalle.periodo} nivel={nivel} />
  {
    decisiones.length > 0 && (
      <Fragment>
        <Subtitulo>{txc.decisionesSinVotacionNominal}</Subtitulo>
        <ul class="chico" data-decisiones-ficha>
          {decisiones.map((d: any) => <li>{d.fecha} · {d.camara ?? sinDato} · {d.etapa ?? sinDato} · <strong>{d.resultado}</strong></li>)}
        </ul>
      </Fragment>
    )
  }
</section>

<style>
  .registro + .registro {
    border-top: var(--borde-ancho) solid var(--color-borde);
    margin-top: var(--espacio-5);
  }
  .titulo {
    font-size: var(--tamano-titulo-3);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--ancho-campo-filtro), 1fr));
    gap: var(--espacio-3) var(--espacio-4);
  }
  dt {
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  dd {
    margin: 0;
  }
  .nota {
    padding: var(--espacio-2) var(--espacio-3);
    background: var(--color-superficie);
  }
</style>
