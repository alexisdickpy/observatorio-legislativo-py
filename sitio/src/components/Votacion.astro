---
// Una votación nominal: textos oficiales, totales, posición de cada partido agrupada por sentido
// (#44), desglose por partido y bancada y voto de cada legislador, con el enlace a su página propia (#45). Recibe los valores ya calculados por lib/ficha.js.
// Estilos globales con prefijo de clase: los estilos con alcance agregan un atributo a cada celda.
import { clasePartido } from "../lib/partidos.js";
import { legible } from "../lib/texto.js";
import BarraVotos from "./BarraVotos.astro";
import GraficoPartidos from "./GraficoPartidos.astro";
import PosicionPorSentido from "./PosicionPorSentido.astro";
import TablaDesglose from "./TablaDesglose.astro";
import { textos, fill, md } from "../lib/contenido.js";
const tx = textos.votaciones.votacion;
const txc = textos.general.comunes;

interface Props {
  votacion: any;
  nivel: number;
  /** En la página propia de la votación (#45), sin el enlace a sí misma. */
  propia?: boolean;
}
const { votacion: v, nivel, propia = false } = Astro.props;
const Titulo = `h${nivel}`;
const Subtitulo = `h${Math.min(nivel + 1, 6)}`;
const sinDato = txc.sinDato;
---

<section class="votacion" id={v.ancla}>
  <Titulo>{v.fecha ?? sinDato} · {v.etapa ?? sinDato}</Titulo>
  <p class="chico">
    {v.subetapa && <span>{v.subetapa} · </span>}
    {tx.resultado} <strong>{v.resultado ?? sinDato}</strong>
    {v.sesion.numero && <span> {fill(tx.sesionNO, { tipo: v.sesion.tipo, numero: v.sesion.numero })}</span>}
  </p>
  {v.descripcion && <p class="lectura">{v.descripcion}</p>}
  {v.observacion && <p class="lectura chico">{fill(tx.observacion, { observacion: v.observacion })}</p>}

  <p class="chico texto-suave">{fill(tx.totalesSobreLosLegisladoresRegistrados, { registrados: v.registrados })}</p>
  <BarraVotos barra={v.barraTotal} />
  <ul class="totales">
    {
      v.totales.map((t: any) => (
        <li class={t.cantidad ? undefined : "texto-suave"}>
          <span class="categoria">{t.categoria}{t.recuentoPropio && "*"}</span> {t.texto}
        </li>
      ))
    }
  </ul>
  {
    v.hayRecuentoPropio && (
      <p class="chico texto-suave lectura">
        {tx.elCongresoNoPublicaUn}
      </p>
    )
  }
  {
    !v.totalesCoinciden && (
      <p class="nota chico lectura">
        <strong>{tx.notaDelObservatorio}</strong> {tx.losTotalesPublicadosNoCoinciden}{v.recalculados.map((r: any) => `${r.categoria} ${r.cantidad}`).join(" · ")}).
      </p>
    )
  }
  {v.notas.map((n: string) => <p class="nota chico lectura" set:html={md(tx.notaDelObservatorio2, { valor: n })} />)}

  {
    v.posicionesPorSentido.length > 0 && (
      <Fragment>
        <Subtitulo class="subtitulo">{tx.posicionDeCadaPartido}</Subtitulo>
        <PosicionPorSentido grupos={v.posicionesPorSentido} />
      </Fragment>
    )
  }

  <p class="chico texto-suave lectura">
    {tx.enCadaPartidoYBancada}
  </p>
  <Subtitulo class="subtitulo">{txc.porPartido}</Subtitulo>
  <GraficoPartidos votacion={v} />
  <TablaDesglose titulo={tx.porPartidoEnNumeros} grupo="Partido" categorias={v.categorias} filas={v.porPartido} />

  <details>
    <summary>{tx.verPorBancada}</summary>
    <TablaDesglose titulo={tx.porBancada} grupo="Bancada" categorias={v.categorias} filas={v.porBancada} />
  </details>

  <details>
    <summary>{fill(tx.verElVotoDeCada, { votos: v.votos.length })}</summary>
    <div class="desplazable">
      <table class="votos">
        <caption class="solo-lectores">{tx.votoDeCadaLegislador}</caption>
        <thead>
          <tr>
            <th scope="col">{tx.voto}</th>
            <th scope="col">{tx.legislador}</th>
            <th scope="col">{txc.partido}</th>
            <th scope="col">{txc.bancada}</th>
          </tr>
        </thead>
        <tbody data-paginar>
          {/* Filas en una sola línea: con compressHTML desactivado, la sangría se copia en cada celda. */}
          {v.votos.map((x: any) => <tr><td>{x.sentido}</td><th scope="row">{x.ficha ? <a href={x.ficha}>{x.nombre ?? sinDato}</a> : (x.nombre ?? sinDato)}{x.observacion && <span class="texto-suave"> ({x.observacion})</span>}</th><td>{x.partido && <span class={`pip ${clasePartido(x.partido)}`}></span>} {legible(x.partido) ?? sinDato}{x.partidoConocido && ` (${x.partidoConocido})`}</td><td>{legible(x.bancada) ?? sinDato}</td></tr>)}
        </tbody>
      </table>
    </div>
  </details>

  <p class="chico">{!propia && <Fragment><a href={v.pagina}>{tx.compartirEstaVotacion}</a> · </Fragment>}<a href={v.url}>{txc.votacionEnSilpy}</a>{v.sesion.url && <Fragment> · <a href={v.sesion.url}>{tx.sesionEnSilpy}</a></Fragment>}</p>
</section>

<style is:global>
  .votacion {
    border-top: var(--borde-ancho) solid var(--color-borde);
    padding-top: var(--espacio-2);
  }
  .votacion .subtitulo {
    font-size: var(--tamano-base);
    margin-top: var(--espacio-4);
  }
  .votacion .totales {
    margin-top: var(--espacio-2);
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2) var(--espacio-4);
  }
  .votacion .categoria {
    font-weight: var(--peso-fuerte);
  }
  .votacion .nota {
    padding: var(--espacio-2) var(--espacio-3);
    background: var(--color-superficie);
  }
  .votacion details {
    margin-bottom: var(--espacio-4);
  }
  .votacion summary {
    cursor: pointer;
    color: var(--color-enlace);
    padding: var(--espacio-2) 0;
  }
  .votacion .desplazable {
    overflow-x: auto;
  }
  .votacion .votos {
    border-collapse: collapse;
    font-size: var(--tamano-chico);
    min-width: 100%;
  }
  .votacion .votos th,
  .votacion .votos td {
    text-align: left;
    vertical-align: top;
    padding: var(--espacio-1) var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
  }
  .votacion .votos thead th {
    border-bottom-width: var(--foco-ancho);
  }
  .votacion .votos tbody th,
  .votacion .votos td:last-child {
    font-weight: var(--peso-normal);
    min-width: var(--ancho-campo-filtro);
  }
  .votacion .votos td:first-child {
    white-space: nowrap;
  }
</style>
