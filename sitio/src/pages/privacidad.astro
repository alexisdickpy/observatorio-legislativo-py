---
import Base from "../layouts/Base.astro";
import Secciones from "../components/Secciones.astro";
import { actualizacion, cita } from "../lib/catalogo.js";
import { crudo, textos } from "../lib/contenido.js";

const tx = textos.privacidad;
const fuente = cita();
const fecha = actualizacion();
const valores = {
  cita: fuente.cita,
  licencia: fuente.licencia,
  fecha: crudo(`<time datetime="${fecha.iso}">${fecha.texto}</time>`),
};
---

<Base titulo={tx.pagina.titulo} descripcion={tx.pagina.descripcion}>
  <div class="lectura">
    <h1>{tx.pagina.titulo}</h1>
    <Secciones secciones={tx.secciones} valores={valores} />
  </div>
</Base>
