---
// Rankings del período vigente (alcance acordado en #57). Dos listas por cámara, cada una con su cifra
// de la vista comparativa, sin recalcularla, con numerador y denominador y un mínimo para entrar.
// - Más «rebeldes» (lib/votosDistintos.js, #54), votos distintos a la mayoría de su partido. Debajo de
//   cada lista se nombra a quienes no tienen con quién compararse.
// - Más «ausentes» (lib/rankings.js), ausencias en votaciones nominales (#29), con la nota de que la
//   fuente no dice el motivo y de que AUSENTE en una votación no es lo mismo que no ir a la sesión.
// Las dos listas van lado a lado en pantallas anchas y una debajo de la otra en el celular. Los apodos
// van entre comillas, con una línea neutral debajo. La tabla completa sigue en
// /legisladores/votaciones-nominales/ y se enlaza desde aquí.
import Base from "../layouts/Base.astro";
import ListaRanking from "../components/ListaRanking.astro";
import { periodos } from "../lib/datos.js";
import { CANTIDAD_RANKING, masAusentes } from "../lib/rankings.js";
import * as rutas from "../lib/rutas.js";
import { votosDistintosAlPartido } from "../lib/votosDistintos.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.rankings.pagina;
const txc = textos.general.comunes;

const periodo = periodos().find((p) => p.vigente).id;
const rebeldes = votosDistintosAlPartido(periodo);
const ausentes = masAusentes(periodo);
const anclas = rutas.anclasRankings;
const numero = (n: number) => n.toLocaleString("es-PY");
const plural = (n: number, singular: string, varios: string) => `${numero(n)} ${n === 1 ? singular : varios}`;
const tabla = rutas.votacionesNominales();
---

<Base
  titulo={tx.rankings}
  descripcion={fill(tx.losSenadoresYLosDiputados, { cantidad: CANTIDAD_RANKING, periodo: periodo })}
>
  <h1>{tx.rankings}</h1>
  <div class="lectura">
    <p>
      {fill(tx.dosListasPorCamaraCon, { cantidad: CANTIDAD_RANKING, periodo: periodo })}
    </p>
    <ul class="chico">
      <li set:html={md(tx.masRebeldesVotosDistintosA, { url1: crudo(`#${anclas.rebeldes}`) })} />
      <li set:html={md(tx.masAusentesAusenciasEnVotaciones, { url1: crudo(`#${anclas.ausentes}`) })} />
    </ul>
    <p class="chico texto-suave" set:html={md(tx.lasCamarasSeMuestranPor, { url1: crudo(tabla) })} />
  </div>

  <div class="columnas">
  <section id={anclas.rebeldes} aria-labelledby="titulo-rebeldes">
    <h2 id="titulo-rebeldes">{tx.masRebeldes}</h2>
    <div class="lectura">
      <p class="subtitulo">{tx.legisladoresQueMasVecesVotaron}</p>
      <p class="formula">
        {tx.votosDistintosVotacionesEnQue}
      </p>
      <ul class="chico">
        <li set:html={md(tx.mayoriaDelPartidoLaCategoria, {  })} />
        <li set:html={md(tx.votacionesComparablesLasVotacionesEn, {  })} />
        <li set:html={md(tx.minimoEntranALaLista, { minimo: rebeldes.minimo })} />
      </ul>
      <p class="chico texto-suave" set:html={md(tx.laFichaDeCadaLegislador, { url1: crudo(rutas.metodologia(rutas.anclasMetodologia.cuadroVotosDistintos)), url2: crudo(rutas.votacionesNominalesOrdenadas("partido")), url3: crudo(rutas.votacionesNominalesOrdenadas("bancada")) })} />
    </div>
    {
      rebeldes.camaras.map((c: any) => (
        <section data-camara-votos-distintos>
          <h3>{c.camara ?? txc.sinDato}</h3>
          <p class="chico texto-suave">{plural(c.votaciones, txc.votacionNominal, txc.votacionesNominales)} {tx.enEstaCamara}</p>
          <ListaRanking filas={c.filas} cifra="mayoriaPartido" />
          <div class="lectura chico notas">
            {c.sinComparables.length > 0 && (
              <>
                <p>
                  {tx.noEstanEnLaLista}
                </p>
                <ul>
                  {c.sinComparables.map((f: any) => (
                    <li data-sin-comparables={f.slug}>
                      <a href={f.url}>{f.nombre}</a> ({f.mayoriaPartido.grupo}){!f.vigente && <span class="texto-suave">{tx.yaNoEjerce}</span>}
                    </li>
                  ))}
                </ul>
              </>
            )}
            {c.bajoMinimo > 0 && (
              <p>
                {plural(c.bajoMinimo, tx.legisladorTiene, tx.legisladoresTienen)} {fill(tx.menosDeVotacionesComparablesY, { minimo: rebeldes.minimo })} {c.bajoMinimo === 1 ? "entra" : "entran"} {tx.aLaListaSusCifras} 
                <a href={rutas.votacionesNominalesOrdenadas("partido")}>{tx.tablaDeVotacionesNominales}</a>.
              </p>
            )}
            {c.sinPartido > 0 && (
              <p>{plural(c.sinPartido, tx.legisladorNoTiene, tx.legisladoresNoTienen)} {tx.partidoRegistradoEnLaApi}</p>
            )}
          </div>
        </section>
      ))
    }
  </section>

  <section id={anclas.ausentes} aria-labelledby="titulo-ausentes">
    <h2 id="titulo-ausentes">{tx.masAusentes}</h2>
    <div class="lectura">
      <p class="subtitulo">{tx.legisladoresConMasAusenciasEn}</p>
      <p class="formula">
        {tx.ausenciasVotacionesNominalesEnQue}
      </p>
      <ul class="chico">
        <li set:html={md(tx.votacionesNominalesTodasLasDel, {  })} />
        <li set:html={md(tx.minimoEntranALaLista2, { minimo: ausentes.minimo })} />
        <li set:html={md(tx.sinMotivoLaFuenteNo, {  })} />
        <li set:html={md(tx.votacionYSesionFigurarComo, {  })} />
      </ul>
      <p class="chico texto-suave" set:html={md(tx.laFichaDeCadaLegislador2, { url1: crudo(rutas.metodologia(rutas.anclasMetodologia.cuadroAusencias)), url2: crudo(rutas.votacionesNominalesOrdenadas("ausencias")) })} />
    </div>
    {
      ausentes.camaras.map((c: any) => (
        <section data-camara-ausencias>
          <h3>{c.camara ?? txc.sinDato}</h3>
          <p class="chico texto-suave">{plural(c.votaciones, txc.votacionNominal, txc.votacionesNominales)} {tx.enEstaCamara}</p>
          <ListaRanking filas={c.filas} cifra="ausencias" />
          {c.bajoMinimo > 0 && (
            <div class="lectura chico notas">
              <p>
                {plural(c.bajoMinimo, tx.legisladorFigura, tx.legisladoresFiguran)} {fill(tx.enMenosDeVotacionesNominales, { minimo: ausentes.minimo })} {c.bajoMinimo === 1 ? "entra" : "entran"} {tx.aLaListaSusCifras} 
                <a href={rutas.votacionesNominalesOrdenadas("ausencias")}>{tx.tablaDeVotacionesNominales}</a>.
              </p>
            </div>
          )}
        </section>
      ))
    }
  </section>
  </div>
</Base>

<style>
  .formula {
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--color-superficie);
    border-left: var(--foco-ancho) solid var(--color-acento);
  }
  .subtitulo {
    font-size: var(--tamano-titulo-3);
    margin-top: 0;
  }
  .notas {
    margin-top: var(--espacio-3);
  }
  /* Una columna por lista; en pantallas angostas pasan a una sola columna. */
  .columnas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: var(--espacio-3) var(--espacio-6);
    margin-top: var(--espacio-6);
  }
  /* Título, explicación y cada cámara comparten fila entre las dos listas: los cuadros arrancan a la misma altura. */
  .columnas > section {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    min-width: 0;
  }
  .columnas > section > h2 {
    margin-top: 0;
  }
</style>
