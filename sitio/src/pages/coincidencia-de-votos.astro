---
// Coincidencia de votos entre partidos y entre bancadas del período vigente (lib/coincidencia.js,
// alcance acordado en #43). Se elige un grupo y se ve su coincidencia con cada uno de los demás, de
// mayor a menor, con numerador y denominador. Los partidos se ponen lado a lado por cámara, sin sumar
// senadores y diputados; las bancadas, dentro de su cámara. Títulos neutrales y fórmula visible.
import Base from "../layouts/Base.astro";
import CuadroCoincidencia from "../components/CuadroCoincidencia.astro";
import SelectorCoincidencia from "../components/SelectorCoincidencia.astro";
import TablaCoincidencia from "../components/TablaCoincidencia.astro";
import { NOMBRE_COINCIDENCIA } from "../lib/calculados.js";
import { coincidencia } from "../lib/coincidencia.js";
import { periodos } from "../lib/datos.js";
import * as rutas from "../lib/rutas.js";

const periodo = periodos().find((p) => p.vigente).id;
import { clasePartido } from "../lib/partidos.js";
import { legible } from "../lib/texto.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.coincidencia.pagina;
const txc = textos.general.comunes;

const { camaras, partidos, bancadas, cuadros, umbral } = coincidencia(periodo);
const columnas = camaras.map((c) => c.camara);
const plural = (n: number, singular: string, varios: string) => `${n.toLocaleString("es-PY")} ${n === 1 ? singular : varios}`;
/** Resumen de un grupo en una cámara: en cuántas votaciones tuvo posición y cuántos empates. */
const resumen = (g: any, votaciones: number) =>
  fill(tx.resumenGrupo, {
    legisladores: plural(g.legisladores, tx.unLegislador, tx.variosLegisladores),
    conPosicion: g.conPosicion.toLocaleString("es-PY"),
    votaciones: plural(votaciones, tx.unaVotacion, tx.variasVotaciones),
  }) + (g.empates ? ` ${fill(tx.yEmpato, { empates: plural(g.empates, tx.unaVotacion, tx.variasVotaciones) })}` : "");
const secciones = [
  { etiqueta: tx.partidos, opciones: partidos.map((p: any) => ({ valor: p.valor, etiqueta: legible(p.nombre) })) },
  ...bancadas.map((b: any) => ({
    etiqueta: fill(tx.bancadas, { camara: b.camara }),
    opciones: b.grupos.map((g: any) => ({ valor: g.valor, etiqueta: legible(g.nombre) })),
  })),
];
---

<Base
  titulo={txc.coincidenciaDeVotosEntrePartidos}
  descripcion={fill(tx.queTanSeguidoVotaronIgual, { periodo: periodo })}
>
  <p class="chico" set:html={md(tx.todosLosLegisladores, { url1: crudo(rutas.legisladores()) })} />
  <h1>{txc.coincidenciaDeVotosEntrePartidos}</h1>
  <div class="lectura">
    <p>
      {fill(tx.paraCadaPartidoYCada, { periodo: periodo })}
    </p>
    <p class="formula">
      {tx.coincidenciaVotacionesEnQueLos}
    </p>
    <ul class="chico">
      <li set:html={md(tx.posicionDeUnGrupoLa, {  })} />
      <li set:html={md(tx.empateSiDosOMas, {  })} />
      <li set:html={md(tx.pocasVotacionesEnComunCon, { umbral: umbral })} />
      <li>
        {tx.coincidirONoCoincidirNo}
      </li>
    </ul>
    <p class="chico texto-suave">
      {tx.cadaVotacionEsDeUna}
      <a href={rutas.metodologia(rutas.anclasMetodologia.partidoUnificado)}>{tx.partidoUnificado}</a>{tx.quePermitePonerLadoA} 
      <a href={rutas.metodologia(rutas.anclasMetodologia.coincidencia)}>{tx.comoSeCalculaLaCoincidencia}</a>
      {" · "}
      <a href={rutas.archivoCalculado(periodo, NOMBRE_COINCIDENCIA, "csv")} download>{txc.descargarLaTablaCsv}</a>
    </p>
  </div>

  <section>
    <h2>{tx.todosLosParesDePartidos}</h2>
    <p class="chico texto-suave">
      {fill(tx.cadaCeldaEsLaCoincidencia, { umbral: umbral })}
    </p>
    {
      cuadros.map((c: any) => (
        <Fragment>
          <h3>{c.camara}</h3>
          <CuadroCoincidencia titulo={fill(tx.coincidenciaEntreTodosLosPares, { camara: c.camara })} filas={c.filas} />
        </Fragment>
      ))
    }
  </section>

  <h2>{tx.unPartidoOUnaBancada}</h2>
  <SelectorCoincidencia secciones={secciones} />

  <section data-bloque>
    <h3>{txc.porPartido}</h3>
    {
      partidos.map((p: any) => (
        <section class="grupo-coincidencia" id={p.valor} data-grupo={p.valor}>
          <h4><span class={`pip ${clasePartido(p.nombre)}`}></span> {legible(p.nombre)}</h4>
          <ul class="chico texto-suave">
            {p.porCamara.map((g: any, n: number) =>
              g ? (
                <li>
                  {fill(tx.conElTextoOficial, { valor: columnas[n], texto: g.texto, votaciones: resumen(g, camaras[n].votaciones) })}
                </li>
              ) : (
                <li>{fill(tx.sinLegisladoresDeEstePartido, { valor: columnas[n] })}</li>
              ),
            )}
          </ul>
          <TablaCoincidencia
            titulo={fill(tx.coincidenciaDeConLosDemas, { nombre: p.nombre })}
            grupo="Partido"
            columnas={columnas}
            filas={p.filas}
          />
        </section>
      ))
    }
  </section>

  {
    bancadas.map((b: any) => (
      <section data-bloque>
        <h3>{fill(tx.porBancada, { camara: b.camara })}</h3>
        {b.grupos.map((g: any) => (
          <section class="grupo-coincidencia" id={g.valor} data-grupo={g.valor}>
            <h4>{legible(g.nombre)}</h4>
            <p class="chico texto-suave">{fill(tx.enLa, { camara: b.camara })} {resumen(g, camaras.find((c: any) => c.camara === b.camara).votaciones)}.</p>
            <TablaCoincidencia
              titulo={fill(tx.coincidenciaDeConLasDemas, { nombre: g.nombre, camara: b.camara })}
              grupo="Bancada"
              columnas={[tx.coincidencia]}
              filas={g.filas.map((f: any) => ({ nombre: f.nombre, celdas: [f] }))}
            />
          </section>
        ))}
      </section>
    ))
  }
</Base>

<style>
  .formula {
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--color-superficie);
    border-left: var(--foco-ancho) solid var(--color-acento);
  }
  .grupo-coincidencia {
    margin-bottom: var(--espacio-5);
  }
  .grupo-coincidencia h4 {
    font-size: var(--tamano-titulo-3);
  }
</style>
