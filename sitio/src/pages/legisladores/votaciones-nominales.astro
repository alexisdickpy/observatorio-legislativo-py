---
// Vista comparativa del período vigente: por cámara, las ausencias, NO VOTA y abstenciones de cada
// legislador en votaciones nominales y sus votos distintos a la mayoría de su bancada y de su partido,
// cada cifra por separado y con su denominador (lib/legisladores.js, comparativa). Títulos neutrales y
// fórmula visible (alcance acordado en #38 y #39).
import Base from "../../layouts/Base.astro";
import OrdenComparativa from "../../components/OrdenComparativa.astro";
import TablaComparativa from "../../components/TablaComparativa.astro";
import { NOMBRE_VOTACIONES_NOMINALES } from "../../lib/calculados.js";
import { periodos } from "../../lib/datos.js";
import { comparativa } from "../../lib/legisladores.js";
import * as rutas from "../../lib/rutas.js";
import { textos, fill, md, crudo } from "../../lib/contenido.js";
const tx = textos.legisladores.comparativa;
const txc = textos.general.comunes;

const periodo = periodos().find((p) => p.vigente).id;
const { camaras } = comparativa(periodo);
---

<Base
  titulo={tx.votacionesNominalesPorLegislador}
  descripcion={fill(tx.cuantasVecesFiguraCadaSenador, { periodo: periodo })}
>
  <p class="chico" set:html={md(tx.todosLosLegisladores, { url1: crudo(rutas.legisladores()) })} />
  <h1>{tx.votacionesNominalesPorLegislador}</h1>
  <div class="lectura">
    <p>
      {fill(tx.paraCadaLegisladorDelPeriodo, { periodo: periodo })}
    </p>
    <h2 class="titulo-formula">{tx.ausenciasNoVotaYAbstenciones}</h2>
    <p class="formula">
      {tx.cifraDeCadaCategoriaVotaciones}
    </p>
    <ul class="chico">
      <li set:html={md(tx.ausenciasEnVotacionesNominalesAusente, {  })} />
      <li set:html={md(tx.noVotaFiguraEnLa, {  })} />
      <li set:html={md(tx.abstencionBlancoVotoOficialDe, {  })} />
    </ul>
    <h2 class="titulo-formula">{tx.votosDistintosALaMayoria}</h2>
    <p class="formula">
      {tx.votosDistintosVotacionesEnQue}
    </p>
    <ul class="chico">
      <li set:html={md(tx.mayoriaDelGrupoLaCategoria, {  })} />
      <li set:html={md(tx.votacionesComparablesLasVotacionesEn, {  })} />
      <li>
        {tx.votarDistintoALaMayoria}
      </li>
    </ul>
    <p class="chico texto-suave">
      {tx.lasCamarasSeMuestranPor} 
      <a href={rutas.metodologia(rutas.anclasMetodologia.noVotaAbstencion)}>{tx.comoSeCalculanLasAusencias}</a>
      {" · "}
      <a href={rutas.metodologia(rutas.anclasMetodologia.mayoria)}>{tx.comoSeCalculanLosVotos}</a>
      {" · "}
      <a href={rutas.archivoCalculado(periodo, NOMBRE_VOTACIONES_NOMINALES, "csv")} download>{txc.descargarLaTablaCsv}</a>
      {" · "}
      <a href={rutas.rankings()}>{tx.rankingsDeMasRebeldesY}</a>
      {" · "}
      <a href={rutas.coincidencia()}>{txc.coincidenciaDeVotosEntrePartidos}</a>
    </p>
  </div>
  <OrdenComparativa />
  {
    camaras.map((c: any) => (
      <section>
        <h2>{c.camara ?? txc.sinDato} ({c.filas.length})</h2>
        <TablaComparativa titulo={fill(tx.tituloPorCamara, { camara: c.camara ?? textos.general.comunes.sinDato })} filas={c.filas} />
      </section>
    ))
  }
</Base>

<style>
  .titulo-formula {
    font-size: var(--tamano-titulo-3);
  }
  .formula {
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--color-superficie);
    border-left: var(--foco-ancho) solid var(--color-acento);
  }
</style>
