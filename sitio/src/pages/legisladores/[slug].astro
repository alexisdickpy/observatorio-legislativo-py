---
// Ficha de un legislador: datos oficiales del cargo, resumen e historial de sus votos en las
// votaciones nominales sobre proyectos de ley, ausencias, NO VOTA, abstenciones y votos distintos a la
// mayoría de su bancada y de su partido en todas las votaciones nominales, leyes de su autoría,
// expedientes presentados y comisiones (preparado por lib/legisladores.js).
import Base from "../../layouts/Base.astro";
import { clasePartido } from "../../lib/partidos.js";
import { legible } from "../../lib/texto.js";
import AusenciasVotaciones from "../../components/AusenciasVotaciones.astro";
import ComisionesLegislador from "../../components/ComisionesLegislador.astro";
import ExpedientesPresentados from "../../components/ExpedientesPresentados.astro";
import FiltroVotos from "../../components/FiltroVotos.astro";
import HistorialVotos from "../../components/HistorialVotos.astro";
import NoVotaAbstencion from "../../components/NoVotaAbstencion.astro";
import ResumenVotos from "../../components/ResumenVotos.astro";
import VotosDistintos from "../../components/VotosDistintos.astro";
import { ficha, legisladores } from "../../lib/legisladores.js";
import * as rutas from "../../lib/rutas.js";
import { datosDeLegislador, descripcionDeLegislador, imagenDe } from "../../lib/seo.js";
import { textos, fill, md, crudo } from "../../lib/contenido.js";
const tx = textos.legisladores.ficha;
const txc = textos.general.comunes;

export function getStaticPaths() {
  return legisladores().map((persona) => ({ params: { slug: persona.slug }, props: { persona } }));
}

const { persona } = Astro.props;
const f = ficha(persona);
const varios = f.bloques.length > 1;
const Titulo = varios ? "h3" : "h2";
const sinDato = txc.sinDato;
const actual = f.bloques[0];
const descripcion = descripcionDeLegislador(f, sinDato);
---

<Base
  titulo={f.nombre ?? sinDato}
  descripcion={descripcion}
  imagen={imagenDe(actual.foto, f.nombre ?? sinDato)}
  datos={datosDeLegislador(f, persona.url)}
  tipo="profile"
>
  <p class="chico" set:html={md(tx.todosLosLegisladores, { url1: crudo(rutas.legisladores()) })} />
  <article data-pagefind-body>
    <h1 data-pagefind-meta="title">{f.nombre ?? sinDato}</h1>
    {
      f.bloques.map((b: any) => (
        <section class="bloque">
          {varios && <h2>{fill(tx.periodoLegislativo, { periodo: b.periodo })}</h2>}
          <div class="cabecera">
            {b.foto && (
              <figure>
                <img src={b.foto} alt={fill(textos.general.buscadores.fotoOficial, { nombre: b.nombre ?? sinDato })} width="160" height="160" />
                <figcaption class="chico texto-suave">{tx.fotoDelCongresoNacionalSilpy}</figcaption>
              </figure>
            )}
            <dl>
              <div><dt>{tx.periodoLegislativo2}</dt><dd>{b.periodo}</dd></div>
              <div><dt>{txc.camara}</dt><dd>{b.camara ?? sinDato}</dd></div>
              <div><dt>{tx.tipo}</dt><dd>{b.tipo ?? sinDato}</dd></div>
              <div><dt>{txc.departamento}</dt><dd>{b.departamento ?? sinDato}</dd></div>
              <div><dt>{txc.partido}</dt><dd>{b.partido && <span class={`pip ${clasePartido(b.partido)}`}></span>} {legible(b.partido) ?? sinDato}{b.partidoConocido && ` (${b.partidoConocido})`}</dd></div>              <div><dt>{txc.bancada}</dt><dd>{legible(b.bancada) ?? sinDato}</dd></div>
              <div><dt>{tx.cargoEnLaBancada}</dt><dd class={b.cargoBancada ? undefined : "texto-suave"}>{b.cargoBancada ?? sinDato}</dd></div>
              <div><dt>{tx.correo}</dt><dd class={b.correo ? "contacto" : "texto-suave"}>{b.correo ? <a href={`mailto:${b.correo}`}>{b.correo}</a> : sinDato}</dd></div>
              <div><dt>{tx.telefono}</dt><dd class={b.telefono ? undefined : "texto-suave"}>{b.telefono ?? sinDato}</dd></div>
              {b.periodoVigente && <div><dt>{tx.situacion}</dt><dd>{b.vigente ? tx.enEjercicio : tx.yaNoEjerce}</dd></div>}
            </dl>
          </div>
          {
            b.periodoVigente && !b.vigente && (
              <p class="aviso lectura">
                {tx.yaNoFiguraEntreLos}
              </p>
            )
          }
          <p class="aviso chico lectura">
            {fill(tx.partidoYBancadaSonLos, { periodo: b.periodo })}
            {b.camara === "CAMARA DE SENADORES" && tx.losSenadoresSeEligenEn}
            {b.partidoConocido && tx.elNombreEntreParentesisEs}            {" "}<a href={rutas.metodologia(rutas.anclasMetodologia.afiliacion)}>{tx.masInformacion}</a>
          </p>
          {b.urlSilpy && <p class="chico" set:html={md(tx.fichaOficialEnSilpy, { url1: crudo(b.urlSilpy) })} />}

          <div data-pagefind-ignore="all" data-votos>
            <Titulo>{tx.susVotosEnVotacionesNominales}</Titulo>
            {
              b.votos.total === 0 ? (
                <p class="lectura">
                  {fill(tx.noFiguraEnNingunaVotacion, { periodo: b.periodo })}
                </p>
              ) : (
                <Fragment>
                  {b.votos.porEstado.length > 1 && <FiltroVotos porEstado={b.votos.porEstado} total={b.votos.total} periodo={b.periodo} />}
                  <ResumenVotos votos={b.votos} periodo={b.periodo} />
                </Fragment>
              )
            }

            <Titulo>{tx.ausenciasEnVotacionesNominales}</Titulo>
            {
              b.ausencias.total === 0 ? (
                <p class="lectura">{fill(tx.noFiguraEnNingunaVotacion2, { periodo: b.periodo })}</p>
              ) : (
                <AusenciasVotaciones ausencias={b.ausencias} periodo={b.periodo} camara={b.camara} />
              )
            }

            {
              b.ausencias.total > 0 && (
                <Fragment>
                  <Titulo>{tx.noVotaYAbstencionesEn}</Titulo>
                  <NoVotaAbstencion noVota={b.noVota} abstencion={b.abstencion} periodo={b.periodo} />
                </Fragment>
              )
            }

            {
              b.mayoria.emitidos > 0 && (
                <Fragment>
                  <Titulo>{tx.votosDistintosALaMayoria}</Titulo>
                  <VotosDistintos mayoria={b.mayoria} periodo={b.periodo} />
                </Fragment>
              )
            }

            <Titulo>{fill(tx.leyesSancionadasDeSuAutoria, { autoria: b.autoria.length })}</Titulo>
            {
              b.autoria.length === 0 ? (
                <p class="lectura">
                  {fill(tx.noFiguraEntreLosAutores, { periodo: b.periodo })}
                </p>
              ) : (
                <Fragment>
                  <p class="chico texto-suave lectura">
                    {tx.leyesDelPeriodoEnCuyo}
                  </p>
                  <ul class="autoria">
                    {b.autoria.map((l: any) => <li><a href={l.url}>{fill(tx.ley, { numero: l.numero })}</a> <span class="texto-suave chico">· {l.fechaSancion ? fill(tx.sancionadaEl, { fechaSancion: l.fechaSancion }) : tx.fechaDeSancionSinDato}</span><span class="titulo chico">{l.titulo ?? sinDato}</span></li>)}
                  </ul>
                </Fragment>
              )
            }

            <Titulo>{fill(tx.expedientesPresentadosEnElPeriodo, { total: b.expedientes.total })}</Titulo>
            <ExpedientesPresentados expedientes={b.expedientes} periodo={b.periodo} urlLista={rutas.expedientesLegislador(persona.slug)} />

            <Titulo>{tx.comisiones}</Titulo>
            <ComisionesLegislador comisiones={b.comisiones} periodo={b.periodo} />

            {
              b.votos.total > 0 && (
                <Fragment>
                  <Titulo>{fill(tx.historialDeVotos, { total: b.votos.total })}</Titulo>
                  <p class="chico texto-suave lectura" set:html={md(tx.deLaMasRecienteA, { url1: crudo(rutas.metodologia(rutas.anclasMetodologia.votosLegislador)) })} />
                  <HistorialVotos historial={b.votos.historial} />
                </Fragment>
              )
            }
          </div>
        </section>
      ))
    }
  </article>
</Base>

<style>
  .cabecera {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-4) var(--espacio-5);
    align-items: flex-start;
    margin-bottom: var(--espacio-4);
  }
  figure {
    margin: 0;
  }
  img {
    display: block;
    width: var(--tamano-foto-legislador);
    height: var(--tamano-foto-legislador);
    object-fit: cover;
    border-radius: var(--radio);
    background: var(--color-superficie);
  }
  figcaption {
    margin-top: var(--espacio-1);
  }
  dl {
    flex: 1 1 20rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--ancho-campo-filtro), 1fr));
    gap: var(--espacio-3) var(--espacio-4);
    margin: 0;
  }
  dt {
    font-size: var(--tamano-chico);
    color: var(--color-texto-suave);
  }
  dd {
    margin: 0;
  }
  .contacto {
    overflow-wrap: anywhere;
  }
  .aviso {
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--color-superficie);
    border-left: var(--foco-ancho) solid var(--color-acento);
  }
  .autoria {
    padding-left: var(--espacio-4);
  }
  .autoria li + li {
    margin-top: var(--espacio-2);
  }
  .autoria .titulo {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--lineas-titulo-catalogo);
    line-clamp: var(--lineas-titulo-catalogo);
    overflow: hidden;
  }
</style>
