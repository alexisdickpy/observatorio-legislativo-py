---
// Proyectos de ley de los que un legislador figura como autor en cada período (#27), del más reciente
// al más antiguo, con su estado oficial y enlace al expediente en SILpy. Solo para quienes tienen al
// menos uno (lib/legisladores.js, conProyectosDeLey).
import Base from "../../../layouts/Base.astro";
import FiltroExpedientes from "../../../components/FiltroExpedientes.astro";
import { conProyectosDeLey, ficha } from "../../../lib/legisladores.js";
import * as rutas from "../../../lib/rutas.js";
import { textos, fill, md, crudo } from "../../../lib/contenido.js";
const tx = textos.legisladores.listaExpedientes;
const txc = textos.general.comunes;

export function getStaticPaths() {
  return conProyectosDeLey().map((persona) => ({ params: { slug: persona.slug }, props: { persona } }));
}

const { persona } = Astro.props;
const f = ficha(persona);
const sinDato = txc.sinDato;
const nombre = f.nombre ?? sinDato;
const bloques = f.bloques.filter((b: any) => b.expedientes.proyectosDeLey.total > 0);
const varios = f.bloques.length > 1;
const total = bloques.reduce((s: number, b: any) => s + b.expedientes.proyectosDeLey.total, 0);
---

<Base
  titulo={fill(tx.proyectosDeLeyDe, { nombre: nombre })}
  descripcion={fill(tx.proyectosDeLeyDeLos, { total: total, nombre: nombre })}
>
  <p class="chico" set:html={md(tx.fichaDe, { url1: crudo(persona.url), nombre: nombre })} />
  <h1>{fill(tx.proyectosDeLeyDe, { nombre: nombre })}</h1>
  <p class="chico texto-suave lectura" set:html={md(tx.proyectosDeLeyIngresadosDesde, { url1: crudo(rutas.metodologia(rutas.anclasMetodologia.expedientes)) })} />
  {
    bloques.map((b: any) => (
      <section data-expedientes>
        {varios && <h2>{fill(tx.periodoLegislativo, { periodo: b.periodo })}</h2>}
        {b.expedientes.proyectosDeLey.porEstado.length > 1 && (
          <FiltroExpedientes porEstado={b.expedientes.proyectosDeLey.porEstado} total={b.expedientes.proyectosDeLey.total} periodo={b.periodo} />
        )}
        <div class="historial-desplazable">
          <table class="lista-expedientes">
            <caption class="solo-lectores">{fill(tx.proyectosDeLeyDelPeriodo, { periodo: b.periodo })}</caption>
            <thead>
              <tr>
                <th scope="col">{tx.ingreso}</th>
                <th scope="col">{tx.proyecto}</th>
                <th scope="col">{txc.estado}</th>
              </tr>
            </thead>
            <tbody>
              {b.expedientes.proyectosDeLey.lista.map((x: any) => <tr data-estado={x.filtro}><td>{x.fecha ?? sinDato}</td><td>{x.url ? <a href={x.url}>{txc.expediente} {x.expediente ?? sinDato}</a> : fill(textos.general.comunes.expedienteNumero, { expediente: x.expediente ?? sinDato })}<span class="titulo">{x.titulo ?? sinDato}</span></td><td>{x.estado ?? sinDato}</td></tr>)}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .historial-desplazable {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    font-size: var(--tamano-chico);
    min-width: 100%;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--espacio-1) var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
  }
  thead th {
    border-bottom-width: var(--foco-ancho);
  }
  td:first-child,
  td:last-child {
    white-space: nowrap;
  }
  td:nth-child(2) {
    min-width: var(--ancho-nombre-barra);
  }
  .titulo {
    display: block;
    overflow-wrap: anywhere;
  }
  tr[hidden] {
    display: none;
  }
</style>
