---
// Proyectos de ley de los que un legislador figura como autor en cada período (#27), del más reciente
// al más antiguo, con su estado oficial y enlace al expediente en SILpy. Solo para quienes tienen al
// menos uno (lib/legisladores.js, conProyectosDeLey).
import Base from "../../../layouts/Base.astro";
import FiltroExpedientes from "../../../components/FiltroExpedientes.astro";
import { conProyectosDeLey, ficha } from "../../../lib/legisladores.js";
import * as rutas from "../../../lib/rutas.js";

export function getStaticPaths() {
  return conProyectosDeLey().map((persona) => ({ params: { slug: persona.slug }, props: { persona } }));
}

const { persona } = Astro.props;
const f = ficha(persona);
const sinDato = "Sin dato";
const nombre = f.nombre ?? sinDato;
const bloques = f.bloques.filter((b: any) => b.expedientes.proyectosDeLey.total > 0);
const varios = f.bloques.length > 1;
const total = bloques.reduce((s: number, b: any) => s + b.expedientes.proyectosDeLey.total, 0);
---

<Base
  titulo={`Proyectos de ley de ${nombre}`}
  descripcion={`${total} proyectos de ley de los que ${nombre} figura entre los autores, con su estado oficial y su expediente en SILpy.`}
>
  <p class="chico"><a href={persona.url}>← Ficha de {nombre}</a></p>
  <h1>Proyectos de ley de {nombre}</h1>
  <p class="chico texto-suave lectura">
    Proyectos de ley ingresados desde el inicio del período en que figura entre los autores, del más
    reciente al más antiguo. La cantidad no mide la calidad ni el esfuerzo. Un proyecto con varios autores
    cuenta para cada uno, y el estado es el de la última actualización.{" "}
    <a href={rutas.metodologia(rutas.anclasMetodologia.expedientes)}>Más información</a>
  </p>
  {
    bloques.map((b: any) => (
      <section data-expedientes>
        {varios && <h2>Período legislativo {b.periodo}</h2>}
        {b.expedientes.proyectosDeLey.porEstado.length > 1 && (
          <FiltroExpedientes porEstado={b.expedientes.proyectosDeLey.porEstado} total={b.expedientes.proyectosDeLey.total} periodo={b.periodo} />
        )}
        <div class="historial-desplazable">
          <table class="lista-expedientes">
            <caption class="solo-lectores">Proyectos de ley del período {b.periodo}</caption>
            <thead>
              <tr>
                <th scope="col">Ingreso</th>
                <th scope="col">Proyecto</th>
                <th scope="col">Estado</th>
              </tr>
            </thead>
            <tbody>
              {b.expedientes.proyectosDeLey.lista.map((x: any) => <tr data-estado={x.filtro}><td>{x.fecha ?? sinDato}</td><td>{x.url ? <a href={x.url}>Expediente {x.expediente ?? sinDato}</a> : `Expediente ${x.expediente ?? sinDato}`}<span class="titulo">{x.titulo ?? sinDato}</span></td><td>{x.estado ?? sinDato}</td></tr>)}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .historial-desplazable {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    font-size: var(--tamano-chico);
    min-width: 100%;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--espacio-1) var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
  }
  thead th {
    border-bottom-width: var(--foco-ancho);
  }
  td:first-child,
  td:last-child {
    white-space: nowrap;
  }
  td:nth-child(2) {
    min-width: var(--ancho-nombre-barra);
  }
  .titulo {
    display: block;
    overflow-wrap: anywhere;
  }
  tr[hidden] {
    display: none;
  }
</style>
