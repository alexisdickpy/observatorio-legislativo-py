---
// Mapa de diputados en ejercicio por departamento (#65).
import Base from "../../layouts/Base.astro";
import MapaDepartamentos from "../../components/MapaDepartamentos.astro";
import { periodos } from "../../lib/datos.js";
import { mapaDeDiputados } from "../../lib/mapa.js";
import * as rutas from "../../lib/rutas.js";
import { textos, fill, md, crudo } from "../../lib/contenido.js";
const tx = textos.legisladores.mapa;

const periodo = periodos().find((p) => p.vigente).id;
const mapa = mapaDeDiputados(periodo);
---

<Base
  titulo={tx.mapaDeDiputadosPorDepartamento}
  descripcion={fill(tx.losDiputadosEnEjercicioDel, { total: mapa.total, periodo: periodo })}
>
  <h1>{tx.mapaDeDiputadosPorDepartamento}</h1>
  <div class="lectura">
    <p>
      {fill(tx.diputadosEnEjercicioEnEl, { total: mapa.total, periodo: periodo })}
    </p>
    <p class="chico texto-suave" set:html={md(tx.losSenadoresNoFiguranPorque, { diputadosQueNoEjercen: mapa.diputadosQueNoEjercen, url1: crudo(rutas.legisladores()), url2: crudo(mapa.urlFuente), licencia: mapa.licencia.toLowerCase(), url3: crudo(rutas.metodologia(rutas.anclasMetodologia.mapa)) })} />
  </div>
  <MapaDepartamentos mapa={mapa} />
</Base>
