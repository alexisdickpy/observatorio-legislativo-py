---
// Listado de legisladores del período vigente: en ejercicio y, aparte, los que ya no ejercen.
import Base from "../../layouts/Base.astro";
import FiltroLegisladores from "../../components/FiltroLegisladores.astro";
import TablaLegisladores from "../../components/TablaLegisladores.astro";
import { periodos } from "../../lib/datos.js";
import { listado, opcionesDelListado } from "../../lib/legisladores.js";
import * as rutas from "../../lib/rutas.js";
import { textos, fill, md, crudo } from "../../lib/contenido.js";
const tx = textos.legisladores.listado;

const periodo = periodos().find((p) => p.vigente).id;
const { enEjercicio, noEjercen } = listado(periodo);
const todos = [...enEjercicio, ...noEjercen];
const conNombreConocido = todos.some((l) => l.partidoConocido);
---

<Base
  titulo={tx.legisladores}
  descripcion={fill(tx.senadoresYDiputadosDelCongreso, { periodo: periodo })}
>
  <h1>{tx.legisladores}</h1>
  <div class="lectura">
    <p>
      {fill(tx.legisladoresEnEjercicioEnEl, { enEjercicio: enEjercicio.length, periodo: periodo })}
    </p>
    <p class="chico texto-suave">
      {tx.losDatosSonLosQue}
      {conNombreConocido && tx.elNombreEntreParentesisEs}
    </p>
    <p set:html={md(tx.votacionesNominalesPorLegisladorUna, { url1: crudo(rutas.votacionesNominales()) })} />
    <p set:html={md(tx.mapaDeDiputadosPorDepartamento, { url1: crudo(rutas.mapaDiputados()) })} />
    <p set:html={md(tx.coincidenciaDeVotosEntrePartidos, { url1: crudo(rutas.coincidencia()) })} />
  </div>
  <FiltroLegisladores entradas={todos.map((l) => l.filtro)} opciones={opcionesDelListado(periodo)} />
  <section data-filtro-legisladores>
    <h2 class="solo-lectores">{tx.enEjercicio}</h2>
    <TablaLegisladores titulo={tx.legisladoresEnEjercicio} filas={enEjercicio} />
  </section>
  {
    noEjercen.length > 0 && (
      <section data-filtro-legisladores>
        <h2>{tx.yaNoEjercenEnEl}</h2>
        <p class="chico texto-suave lectura">
          {fill(tx.legisladoresDelPeriodoQueYa, { noEjercen: noEjercen.length, periodo: periodo })}
        </p>
        <TablaLegisladores titulo={tx.legisladoresQueYaNoEjercen} filas={noEjercen} />
      </section>
    )
  }
</Base>
