---
// Página para direcciones que no existen. Cloudflare Pages la sirve con el código 404; sin ella,
// respondería cualquier dirección con la portada. No se indexa.
import Base from "../layouts/Base.astro";
import * as rutas from "../lib/rutas.js";
import { textos, md, crudo } from "../lib/contenido.js";
const tx = textos.error404.pagina;
---

<Base titulo={tx.paginaNoEncontrada} descripcion={tx.laDireccionNoCorrespondeA} indexar={false}>
  <div class="lectura">
    <h1>{tx.paginaNoEncontrada}</h1>
    <p>{tx.estaDireccionNoCorrespondeA}</p>
    <ul>
      <li set:html={md(tx.irAlInicio, { url1: crudo(rutas.inicio()) })} />
      <li set:html={md(tx.verTodasLasLeyes, { url1: crudo(rutas.leyes()) })} />
      <li set:html={md(tx.verTodosLosLegisladores, { url1: crudo(rutas.legisladores()) })} />
      <li set:html={md(tx.buscarEnElSitio, { url1: crudo(rutas.buscar()) })} />
    </ul>
  </div>
</Base>
