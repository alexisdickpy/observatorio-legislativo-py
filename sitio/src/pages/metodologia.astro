---
// Versión pública de docs/metodologia.md, con sus textos en contenido/metodologia.json y las observaciones
// sobre los datos generadas desde datos/propios/notas.json (lib/metodologia.js).
import Base from "../layouts/Base.astro";
import Secciones from "../components/Secciones.astro";
import { actualizacion, cita } from "../lib/catalogo.js";
import { crudo, fill, md, textos } from "../lib/contenido.js";
import { periodos } from "../lib/datos.js";
import { observacionesDeLosDatos } from "../lib/metodologia.js";
import { tablaDePartidos } from "../lib/partidos.js";
import { temas, TEXTO_PENDIENTE } from "../lib/temas.js";
import * as rutas from "../lib/rutas.js";
import { CANTIDAD_RANKING, MINIMO_VOTACIONES_AUSENCIAS } from "../lib/rankings.js";
import { CANTIDAD_AJUSTADAS, CANTIDAD_ULTIMAS_PORTADA } from "../lib/votaciones.js";
import { CANTIDAD_PORTADA, MINIMO_COMPARABLES } from "../lib/votosDistintos.js";
import { MINIMO_COMPARADAS } from "../lib/afinidad.js";
import { datosDelTest } from "../lib/testAfinidad.js";

const tx = textos.metodologia.pagina;
const fuente = cita();
const partidos = tablaDePartidos();
const agrupados = partidos.filter((g) => g.textos.length > 1);
const fecha = actualizacion();
const vigente = periodos().find((p) => p.vigente);
const observaciones = observacionesDeLosDatos();
const reunidos = agrupados.map((g) => fill(tx.reunidoComo, { textos: g.textos.map((t) => `«${t.texto}»`).join(" y "), nombre: g.nombre })).join("; ");
const valores = {
  periodo: vigente.id,
  cita: fuente.cita,
  licencia: fuente.licencia,
  fecha: crudo(`<time datetime="${fecha.iso}">${fecha.texto}</time>`),
  cantidadRanking: CANTIDAD_RANKING,
  minimoAusencias: MINIMO_VOTACIONES_AUSENCIAS,
  minimoComparables: MINIMO_COMPARABLES,
  cantidadPortada: CANTIDAD_PORTADA,
  cantidadAjustadas: CANTIDAD_AJUSTADAS,
  cantidadUltimas: CANTIDAD_ULTIMAS_PORTADA,
  cantidadTemas: temas().length,
  textoPendiente: TEXTO_PENDIENTE,
  totalPreguntas: datosDelTest(vigente.id).preguntas.length,
  minimoComparadas: MINIMO_COMPARADAS,
  partidosReunidos: agrupados.length > 0 ? fill(tx.hoySeReunen, { lista: reunidos }) : "",
  cuantasObservaciones: observaciones.total === 0 ? tx.hoyNoHayObservaciones : fill(tx.hoyHayObservaciones, { total: observaciones.total }),
};
---

<Base titulo={tx.titulo} descripcion={tx.descripcion}>
  <div class="lectura metodologia">
    <h1>{tx.titulo}</h1>
    <Secciones secciones={textos.metodologia.secciones} valores={valores}>
      <dl slot="temas">
        {
          temas().map((t) => (
            <>
              <dt><a href={t.url}>{t.nombre}</a></dt>
              <dd>{t.definicion}</dd>
            </>
          ))
        }
      </dl>
      <details slot="partidos">
        <summary class="chico">{fill(tx.verPartidos, { total: partidos.length })}</summary>
        <dl class="partidos chico">
          {
            partidos.map((g) => (
              <Fragment>
                <dt>{g.nombre} <span class="texto-suave">({g.id})</span></dt>
                <dd>
                  <ul>
                    {g.textos.map((t) => <li>«{t.texto}»{t.nombreConocido && ` (${t.nombreConocido})`}. {t.fundamento}</li>)}
                  </ul>
                </dd>
              </Fragment>
            ))
          }
        </dl>
        <p class="chico" set:html={md(tx.tablaPartidos, { url: crudo(rutas.archivoDatos("propios/partidos.json")) })} />
      </details>
      <Fragment slot="observaciones">
        {
          observaciones.grupos.map((g) => (
            <section class="observacion">
              <h3 id={g.ancla}>{g.titulo} ({g.casos.length})</h3>
              {g.explicacion && <p>{g.explicacion}</p>}
              <details>
                <summary class="chico">{g.casos.length === 1 ? tx.verElCaso : fill(tx.verLosCasos, { total: g.casos.length })}</summary>
                <ul class="casos chico">
                  {g.casos.map((c) => <li>{c.sitio ? <a href={c.sitio.url}>{c.titulo}</a> : c.titulo}{c.oficial && <Fragment> · <a href={c.oficial.url}>{c.oficial.texto}</a></Fragment>}{c.manual && <span class="texto-suave"> {tx.notaManual}</span>}</li>)}
                </ul>
              </details>
            </section>
          ))
        }
        <p class="chico texto-suave">{tx.casosSinEnlace}</p>
      </Fragment>
    </Secciones>
  </div>
</Base>

<style>
  dt {
    font-weight: var(--peso-fuerte);
  }
  dd {
    margin: 0 0 var(--espacio-3);
  }
  .partidos ul {
    margin: 0;
  }
  .casos li {
    margin-bottom: var(--espacio-1);
  }
</style>
