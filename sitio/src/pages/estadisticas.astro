---
// Estadísticas generales del período vigente (lib/estadisticas.js, #80), con recuentos propios sobre los
// datos abiertos. Cada cámara por separado.
import Base from "../layouts/Base.astro";
import BarrasCifras from "../components/BarrasCifras.astro";
import Hemiciclo from "../components/Hemiciclo.astro";
import { periodos } from "../lib/datos.js";
import { CANTIDAD_AUTORES, estadisticas } from "../lib/estadisticas.js";
import * as rutas from "../lib/rutas.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.estadisticas.pagina;
const txc = textos.general.comunes;

const periodo = periodos().find((p) => p.vigente).id;
const e = estadisticas(periodo);
const numero = (n: number) => n.toLocaleString("es-PY");
---

<Base
  titulo={tx.estadisticas}
  descripcion={fill(tx.cifrasGeneralesDelCongresoNacional, { periodo: periodo })}
>
  <h1>{tx.estadisticas}</h1>
  <p class="lectura">
    {fill(tx.cifrasGeneralesDelPeriodoLegislativo, { periodo: periodo, leyes: numero(e.leyes), votaciones: numero(e.votaciones) })}
  </p>

  <h2>{tx.composicionDeCadaCamara}</h2>
  <div class="columnas">
    {
      e.camaras.map((c: any) => (
        <section>
          <h3>{c.nombre}</h3>
          <Hemiciclo puntos={c.asientos} cifra={String(c.total)} detalle={c.nombre.toUpperCase()} etiqueta={`${c.nombre}: ${c.partidos.map((p: any) => `${p.sigla} ${p.cantidad}`).join(", ")}.`} />
          <BarrasCifras filas={c.partidos.map((p: any) => ({ texto: p.sigla, clase: p.clase, cantidad: p.cantidad }))} />
          <p class="chico texto-suave nota">{tx.bancasSegunElTipoOficial} {c.tipos.map((t: any) => `${t.texto} ${t.cantidad}`).join(" · ")}.{c.vitalicios > 0 && fill(tx.aparteSenadoresVitaliciosSinBanca, { vitalicios: c.vitalicios })}</p>
        </section>
      ))
    }
  </div>

  <h2>{txc.leyesSancionadas}</h2>
  <div class="columnas">
    <section>
      <h3>{tx.porAnoDeSancion}</h3>
      <BarrasCifras filas={e.leyesPorAnio} />
    </section>
    <section>
      <h3>{tx.porIniciativa}</h3>
      <p class="chico texto-suave">{tx.segunElDatoOficialDe}</p>
      <BarrasCifras filas={e.iniciativas} />
    </section>
    <section>
      <h3>{tx.porPartidoDeSusAutores}</h3>
      <p class="chico texto-suave">{tx.unaLeyCuentaUnaVez}</p>
      <BarrasCifras filas={e.leyesPorPartido} />
    </section>
    <section>
      <h3>{tx.legisladoresConMasLeyesDe}</h3>
      <p class="chico texto-suave">{fill(tx.losPrimerosMuchasLeyesTienen, { cantidad: CANTIDAD_AUTORES })}</p>
      <BarrasCifras filas={e.autores} />
    </section>
  </div>

  <h2>{tx.votacionesNominalesSobreProyectosDe}</h2>
  <div class="columnas">
    <section>
      <h3>{tx.porAnoYCamara}</h3>
      <table class="por-anio">
        <caption class="solo-lectores">{tx.votacionesNominalesPorAnoY}</caption>
        <thead><tr><th scope="col">{tx.ano}</th><th scope="col">{tx.senadores}</th><th scope="col">{tx.diputados}</th></tr></thead>
        <tbody>
          {e.votacionesPorAnio.map((a: any) => <tr><th scope="row"><a href={a.url}>{a.anio}</a></th><td>{numero(a.porCamara.find((x: any) => x.camara === "CAMARA DE SENADORES")?.total ?? 0)}</td><td>{numero(a.porCamara.find((x: any) => x.camara === "CAMARA DE DIPUTADOS")?.total ?? 0)}</td></tr>)}
        </tbody>
      </table>
    </section>
    <section>
      <h3>{tx.porResultadoOficial}</h3>
      <BarrasCifras filas={e.resultados} />
    </section>
  </div>
  <h2>{txc.decisionesSinVotacionNominal}</h2>
  <p class="lectura" set:html={md(tx.ademasDecisionesDelPlenarioSobre, { url1: crudo(rutas.decisionesSinNominal()), decisiones: numero(e.decisiones.length) })} />
  <p class="chico texto-suave" set:html={md(tx.metodologiaDatosAbiertos, { url1: crudo(rutas.metodologia()), url2: crudo(rutas.datosAbiertos()) })} />
</Base>

<style>
  .columnas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--espacio-5) var(--espacio-6);
    margin-bottom: var(--espacio-6);
  }
  section {
    min-width: 0;
  }
  h3 {
    margin-top: 0;
  }
  .nota {
    margin-top: var(--espacio-3);
  }
  .por-anio {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--tamano-chico);
  }
  .por-anio th,
  .por-anio td {
    padding: var(--espacio-2) 0;
    border-top: var(--borde-ancho) solid var(--color-borde);
    text-align: right;
  }
  .por-anio th:first-child {
    text-align: left;
  }
</style>
