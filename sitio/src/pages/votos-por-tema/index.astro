---
// Índice de los votos de partidos y bancadas por tema (lib/votosPorTema.js, alcance acordado en #37):
// una tarjeta por tema con la cantidad de votaciones nominales de cada cámara y el enlace a su página.
import Base from "../../layouts/Base.astro";
import { NOMBRE_VOTOS_POR_TEMA } from "../../lib/calculados.js";
import { periodos } from "../../lib/datos.js";
import * as rutas from "../../lib/rutas.js";
import { votosPorTema } from "../../lib/votosPorTema.js";
import { textos, fill } from "../../lib/contenido.js";
const tx = textos.temas.indice;
const txc = textos.general.comunes;

const periodo = periodos().find((p) => p.vigente).id;
const lista = votosPorTema(periodo);
const numero = (n: number) => n.toLocaleString("es-PY");
const plural = (n: number, singular: string, varios: string) => `${numero(n)} ${n === 1 ? singular : varios}`;
---

<Base
  titulo={tx.votosDePartidosPorTema}
  descripcion={fill(tx.comoVotaronLosLegisladoresDe, { periodo: periodo })}
>
  <h1>{tx.votosDePartidosPorTema}</h1>
  <p class="lectura">
    {fill(tx.paraCadaTemaLosVotos, { periodo: periodo })} 
    <a href={rutas.metodologia(rutas.anclasMetodologia.votosPorTema)}>{txc.comoSeCalcula}</a>
    {" · "}
    <a href={rutas.archivoCalculado(periodo, NOMBRE_VOTOS_POR_TEMA, "csv")} download>{txc.descargarLaTablaCsv}</a>
  </p>
  <ul class="temas-votos">
    {
      lista.map((t: any) => (
        <li class="tarjeta-tema" data-tema={t.id}>
          <h2><a href={t.url}>{t.nombre}</a></h2>
          <p class="chico">
            {t.camaras.map((c: any) => `${c.camara} ${plural(c.votaciones.length, "votación", "votaciones")}`).join(" · ")}
          </p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .temas-votos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--espacio-3);
  }
  .tarjeta-tema {
    padding: var(--espacio-3);
    border: var(--borde-ancho) solid var(--color-borde);
    border-top: var(--foco-ancho) solid var(--color-tema, var(--color-borde));
    border-radius: var(--radio);
    background: color-mix(in srgb, var(--color-tema, var(--color-borde)) var(--mezcla-fondo-tema), var(--color-fondo));
  }
  h2 {
    margin: 0 0 var(--espacio-1);
    font-size: var(--tamano-base);
  }
  p {
    margin: 0;
  }
</style>
