---
// Votos de partidos en un tema (lib/votosPorTema.js, alcance acordado en #37): por cámara, el reparto de
// los votos de cada partido en las categorías oficiales, con su
// denominador, y la lista de las votaciones del tema con su etapa. Sin cifra única de apoyo.
import Base from "../../layouts/Base.astro";
import RepartoTema from "../../components/RepartoTema.astro";
import VotacionesTema from "../../components/VotacionesTema.astro";
import { periodos } from "../../lib/datos.js";
import * as rutas from "../../lib/rutas.js";
import { votosPorTema } from "../../lib/votosPorTema.js";
import { textos, fill, md, crudo } from "../../lib/contenido.js";
const tx = textos.temas.tema;
const txc = textos.general.comunes;

export function getStaticPaths() {
  const periodo = periodos().find((p) => p.vigente).id;
  return votosPorTema(periodo).map((t: any) => ({ params: { tema: t.id }, props: { periodo, tema: t } }));
}

const { periodo, tema } = Astro.props;
const otros = votosPorTema(periodo);
const numero = (n: number) => n.toLocaleString("es-PY");
const plural = (n: number, singular: string, varios: string) => `${numero(n)} ${n === 1 ? singular : varios}`;
---

<Base
  titulo={fill(tx.votosDePartidosEn, { nombre: tema.nombre })}
  descripcion={fill(tx.comoVotaronLosLegisladoresDe, { total: numero(tema.total), nombre: tema.nombre, periodo: periodo })}
>
  <p class="chico" set:html={md(tx.votosDePartidosPorTema, { url1: crudo(rutas.votosPorTema()) })} />
  <h1>{fill(tx.votosDePartidosEn, { nombre: tema.nombre })}</h1>
  <div class="lectura">
    {tema.definicion && <p class="texto-suave">{tema.definicion}</p>}
    <p>
      {tx.votosDeCadaPartidoEn} {plural(tema.total, txc.votacionNominal, txc.votacionesNominales)}
      {tx.deEsteTemaSobreTodos} 
      <a href={rutas.metodologia(rutas.anclasMetodologia.votosPorTema)}>{txc.comoSeCalcula}</a>
    </p>
    <p class="chico texto-suave">
      {tx.unNoPuedeSerA}
    </p>
  </div>

  {
    tema.camaras.map((c: any) => (
      <section class="camara-tema">
        <h2>{c.camara}</h2>
        <p class="chico">{plural(c.votaciones.length, txc.votacionNominal, txc.votacionesNominales)} · {plural(c.votos, tx.votoRegistrado, tx.votosRegistrados)}</p>
        <ul class="leyenda chico" aria-hidden="true">
          {c.leyenda.map((l: any) => <li><span class={`muestra ${l.clase}`}></span>{l.categoria}</li>)}
        </ul>
        <RepartoTema titulo={txc.porPartido} categorias={c.categorias} filas={c.partidos} />
        <details>
          <summary>{tx.verLas} {plural(c.votaciones.length, txc.votacion, "votaciones")} {fill(tx.deLa, { camara: c.camara })}</summary>
          <VotacionesTema votaciones={c.votaciones} />
        </details>
      </section>
    ))
  }

  <h2>{tx.otrosTemas}</h2>
  <nav class="otros-temas" aria-label={tx.otrosTemas}>
    {otros.map((t: any) => (t.id === tema.id ? <strong class="tema" data-tema={t.id} aria-current="page">{t.nombreCorto}</strong> : <a class="tema" data-tema={t.id} href={t.url} title={t.nombre}>{t.nombreCorto}</a>))}
  </nav>
</Base>

<style>
  .otros-temas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
    margin-bottom: var(--espacio-4);
  }
  .camara-tema {
    margin-top: var(--espacio-5);
  }
  .leyenda {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1) var(--espacio-4);
  }
  .leyenda li {
    display: flex;
    align-items: center;
    gap: var(--espacio-1);
  }
  .muestra {
    display: inline-block;
    width: var(--espacio-4);
    height: var(--espacio-4);
    border-radius: var(--radio);
  }
</style>
