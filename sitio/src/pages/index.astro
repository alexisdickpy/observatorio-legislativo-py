---
import Base from "../layouts/Base.astro";
import AnalisisPortada from "../components/AnalisisPortada.astro";
import ComposicionCongreso from "../components/ComposicionCongreso.astro";
import CuadroTemas from "../components/CuadroTemas.astro";
import MapaDepartamentos from "../components/MapaDepartamentos.astro";
import UltimaVotacion from "../components/UltimaVotacion.astro";
import { leyes } from "../lib/catalogo.js";
import { periodos } from "../lib/datos.js";
import { mapaDeDiputados } from "../lib/mapa.js";
import * as rutas from "../lib/rutas.js";
import { datosDelSitio } from "../lib/seo.js";
import { datosDelTest } from "../lib/testAfinidad.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.portada.presentacion;
const txc = textos.general.comunes;

const vigente = periodos().find((p) => p.vigente);
const cantidad = leyes().length;
const test = datosDelTest(vigente.id);
const mapa = mapaDeDiputados(vigente.id);
---

<Base
  titulo={textos.general.sitio.nombre}
  descripcion={fill(tx.leyesSancionadasPorElCongreso, { id: vigente.id })}
  datos={datosDelSitio()}
>
  <div class="presentacion">
    <h1>{tx.queVotaElCongresoDel}</h1>
    <p class="lectura">
      {fill(tx.leyesSancionadasPorElCongreso2, { id: vigente.id })}
    </p>
  </div>
  <ComposicionCongreso periodo={vigente.id} />
  <UltimaVotacion periodo={vigente.id} />
  <nav class="accesos" aria-label={tx.seccionesDelSitio}>
    <ul>
      <li set:html={md(tx.verLasLeyesDelPeriodo, { url1: crudo(rutas.leyes()), cantidad: cantidad })} />
      <li set:html={md(tx.verLosLegisladoresSusVotos, { url1: crudo(rutas.legisladores()) })} />
      <li set:html={md(tx.verElMapaDeDiputados, { url1: crudo(rutas.mapaDiputados()) })} />
      <li set:html={md(tx.buscarUnaLey, { url1: crudo(rutas.buscar()) })} />
      <li set:html={md(tx.descargarLosDatosAbiertos, { url1: crudo(rutas.datosAbiertos()) })} />
    </ul>
  </nav>
  <AnalisisPortada periodo={vigente.id} parte="tarjetas" />
  <div class="dos-acciones">
    <section aria-labelledby="test-portada">
      <h2 id="test-portada">{txc.testDeAfinidad}</h2>
      <p>
        {fill(tx.preguntasSobreLeyesVotadasEn, { preguntas: test.preguntas.length })}
      </p>
      <p><a class="boton" href={rutas.testAfinidad()}>{tx.hacerElTest}</a></p>
    </section>
    <section aria-labelledby="telegram-portada">
      <h2 id="telegram-portada">{tx.avisosPorTelegram}</h2>
      <p>
        {tx.unBotTeAvisaDe}
      </p>
      <p><a class="boton" href={rutas.botTelegram()}>{tx.abrirElBot}</a></p>
    </section>
  </div>
  <CuadroTemas periodo={vigente.id} />
  <AnalisisPortada periodo={vigente.id} parte="temas" />
  <section aria-labelledby="mapa-portada">
    <h2 id="mapa-portada">{tx.diputadosPorDepartamento}</h2>
    <p class="lectura" set:html={md(tx.diputadosEnEjercicioElegiUn, { total: mapa.total, url1: crudo(rutas.mapaDiputados()) })} />
    <MapaDepartamentos mapa={mapa} sinLista />
  </section>
  <AnalisisPortada periodo={vigente.id} parte="votaciones" />
</Base>

<style>
  .presentacion {
    padding: var(--espacio-5) 0 var(--espacio-4);
  }
  .presentacion h1 {
    margin: 0 0 var(--espacio-2);
  }
  .presentacion p {
    margin: 0;
    color: var(--color-texto-suave);
  }
  .accesos ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0 var(--espacio-5);
    list-style: none;
    padding: 0;
    margin: var(--espacio-5) 0 0;
  }
  .accesos li {
    border-top: var(--borde-ancho) solid var(--color-borde);
    padding: var(--espacio-2) 0;
  }
  .dos-acciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0 var(--espacio-6);
    margin-top: var(--espacio-6);
    border-top: var(--borde-ancho) solid var(--color-borde-fuerte);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
    padding-bottom: var(--espacio-3);
  }
  .dos-acciones h2 {
    margin-top: var(--espacio-4);
  }
</style>
