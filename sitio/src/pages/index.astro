---
import Base from "../layouts/Base.astro";
import AnalisisPortada from "../components/AnalisisPortada.astro";
import CuadroTemas from "../components/CuadroTemas.astro";
import { leyes } from "../lib/catalogo.js";
import { periodos } from "../lib/datos.js";
import * as rutas from "../lib/rutas.js";
import { datosDelSitio } from "../lib/seo.js";
import { datosDelTest } from "../lib/testAfinidad.js";

const vigente = periodos().find((p) => p.vigente);
const cantidad = leyes().length;
const test = datosDelTest(vigente.id);
---

<Base
  titulo="Observatorio Legislativo"
  descripcion={`Leyes sancionadas por el Congreso Nacional del Paraguay en el período legislativo ${vigente.id}, con datos abiertos.`}
  datos={datosDelSitio()}
>
  <div class="lectura">
    <h1>Observatorio Legislativo</h1>
    <p>
      Leyes sancionadas por el Congreso Nacional del Paraguay en el período legislativo
      {vigente.id}, a partir de los datos abiertos que publica el propio Congreso.
    </p>
    <ul>
      <li><a href={rutas.leyes()}>Ver las {cantidad} leyes del período</a></li>
      <li><a href={rutas.legisladores()}>Ver los legisladores, sus votos y sus leyes</a></li>
      <li><a href={rutas.mapaDiputados()}>Ver el mapa de diputados por departamento</a></li>
      <li><a href={rutas.buscar()}>Buscar una ley</a></li>
      <li><a href={rutas.datosAbiertos()}>Descargar los datos abiertos</a></li>
    </ul>
    <section aria-labelledby="test-portada">
      <h2 id="test-portada">Test de afinidad</h2>
      <p>
        {test.preguntas.length} preguntas sobre leyes votadas en el período. Al final ves cuánto coinciden tus
        respuestas con lo que votó cada partido.
      </p>
      <p><a href={rutas.testAfinidad()}>Hacer el test</a></p>
    </section>
  </div>
  <CuadroTemas periodo={vigente.id} />
  <AnalisisPortada periodo={vigente.id} />
</Base>
