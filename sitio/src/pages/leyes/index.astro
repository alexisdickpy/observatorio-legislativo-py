---
import Base from "../../layouts/Base.astro";
import CuadroTemas from "../../components/CuadroTemas.astro";
import FiltroLeyes from "../../components/FiltroLeyes.astro";
import TablaLeyes from "../../components/TablaLeyes.astro";
import { leyes, opcionesDeFiltro } from "../../lib/catalogo.js";
import { filtrar, ORDEN_PREDETERMINADO } from "../../lib/filtro.js";
import { periodos } from "../../lib/datos.js";
import * as rutas from "../../lib/rutas.js";
import { textos, fill, md, crudo } from "../../lib/contenido.js";
const tx = textos.leyes.catalogo;
const txc = textos.general.comunes;

const lista = leyes();
// Orden inicial: el mismo que aplica el filtro sin parámetros, para que sin JavaScript se vea igual.
const porNumero = new Map(lista.map((l) => [l.numero, l]));
const ordenadas = filtrar(
  lista.map((l) => l.filtro),
  { texto: "", anio: "", camara: "", tema: "", orden: ORDEN_PREDETERMINADO },
).map((e) => porNumero.get(e.numero));
const { anios, camaras, temas } = opcionesDeFiltro();
const nombresPeriodos = periodos().map((p) => p.id).join(", ");
---

<Base
  titulo={tx.leyes}
  descripcion={fill(tx.lasLeyesSancionadasPorEl, { lista: lista.length, nombresPeriodos: nombresPeriodos })}
>
  <h1>{txc.leyesSancionadas}</h1>
  <p class="lectura" set:html={md(tx.leyesDelPeriodoLegislativoEl, { lista: lista.length, nombresPeriodos: nombresPeriodos, url1: crudo(rutas.metodologia(rutas.anclasMetodologia.temas)) })} />
  <CuadroTemas periodo={periodos().find((p) => p.vigente).id} />
  <FiltroLeyes entradas={ordenadas.map((l) => l.filtro)} anios={anios} camaras={camaras} temas={temas} idTabla="tabla-leyes" />
  <div id="tabla-leyes">
    <TablaLeyes leyes={ordenadas} />
  </div>
</Base>
