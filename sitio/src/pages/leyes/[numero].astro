---
// Ficha de una ley: temas según la clasificación propia, datos oficiales, iniciativa, autores y votaciones nominales de cada registro.
import Base from "../../layouts/Base.astro";
import FichaRegistro from "../../components/FichaRegistro.astro";
import TemasLey from "../../components/TemasLey.astro";
import { leyes } from "../../lib/catalogo.js";
import { detalleDeRegistro } from "../../lib/ficha.js";
import * as rutas from "../../lib/rutas.js";
import { datosDeLey, descripcionDeLey, tituloDeLey } from "../../lib/seo.js";
import { textos, fill, md, crudo } from "../../lib/contenido.js";
const tx = textos.leyes.ficha;

export function getStaticPaths() {
  return leyes().map((ley) => ({ params: { numero: ley.numero }, props: { ley } }));
}

const { ley } = Astro.props;
---

<Base titulo={tituloDeLey(ley)} descripcion={descripcionDeLey(ley)} datos={datosDeLey(ley)}>
  <p class="chico" set:html={md(tx.todasLasLeyes, { url1: crudo(rutas.leyes()) })} />
  <article data-pagefind-body>
    <h1 data-pagefind-meta="title">{fill(tx.ley, { numero: ley.numero })}</h1>
    <span data-pagefind-filter="año" hidden>{ley.anio}</span>
    <TemasLey clasificacion={ley.temas} />
    {
      ley.registros.length > 1 && (
        <p class="aviso lectura">
          {fill(tx.elCongresoPublicaRegistrosCon, { registros: ley.registros.length })}
        </p>
      )
    }
    {
      ley.registros.map((registro: any, i: number) => (
        <FichaRegistro
          registro={registro}
          detalle={detalleDeRegistro(registro)}
          encabezado={ley.registros.length > 1 ? fill(tx.registroDe, { valor: i + 1, registros: ley.registros.length }) : null}
        />
      ))
    }
  </article>
</Base>

<style>
  .aviso {
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--color-superficie);
    border-left: var(--foco-ancho) solid var(--color-acento);
  }
</style>
