---
import Base from "../layouts/Base.astro";
import { cita, actualizacion } from "../lib/catalogo.js";
import { descargas } from "../lib/descargas.js";
import * as rutas from "../lib/rutas.js";
import { datosAbiertos } from "../lib/seo.js";
import { textos, md, crudo } from "../lib/contenido.js";
const tx = textos.datos.pagina;
const txc = textos.general.comunes;

const grupos = descargas();
const fuente = cita();
const fecha = actualizacion();
const descripcion =
  tx.descargaDeLosDatosDel;
---

<Base
  titulo={txc.datosAbiertos}
  descripcion={descripcion}
  datos={datosAbiertos(descripcion)}
>
  <h1>{txc.datosAbiertos}</h1>
  <div class="lectura">
    <p set:html={md(tx.todosLosDatosQueUsa, { licencia: fuente.licencia, cita: fuente.cita, fecha: crudo(`<time datetime="${fecha.iso}">${fecha.texto}</time>`) })} />
    <p set:html={md(tx.losArchivosDeValoresOficiales, { url1: crudo(rutas.archivoDatos("diccionario.md")) })} />
    <p set:html={md(tx.lasFotosDeLosLegisladores, { rutaFotos: "/datos/fotos/{período}/{idLegislador}.jpg" })} />
  </div>
  {
    grupos.map((g) => (
      <section>
        <h2>{g.titulo}</h2>
        <table class="descargas">
          <thead>
            <tr>
              <th scope="col">{tx.archivo}</th>
              <th scope="col">{tx.contenido}</th>
              <th scope="col">{tx.descargas}</th>
            </tr>
          </thead>
          <tbody>
            {g.tablas.map((t) => (
              <tr>
                <th scope="row">{t.nombre}</th>
                <td>{t.descripcion}</td>
                <td class="archivos">
                  {t.archivos.map((a) => (
                    <a href={a.url} download>
                      {a.formato} <span class="texto-suave">({a.tamano})</span>
                    </a>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  }
</Base>

<style>
  .descargas {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--tamano-chico);
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--espacio-2);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
  }
  .archivos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1) var(--espacio-3);
    white-space: nowrap;
  }
  /* 48rem = --punto-quiebre-movil */
  @media (max-width: 48rem) {
    tr,
    th,
    td {
      display: block;
    }
    thead {
      display: none;
    }
    tbody th {
      padding-bottom: 0;
      border: 0;
    }
    .archivos {
      display: flex;
    }
  }
</style>
