---
// Listado general de proyectos de ley del período (lib/proyectos.js), con o sin votación nominal, con su
// estado oficial y su enlace. Filtros en el navegador; sin JavaScript se ve la lista completa.
import Base from "../layouts/Base.astro";
import { periodos } from "../lib/datos.js";
import { proyectosDeLey } from "../lib/proyectos.js";
import * as rutas from "../lib/rutas.js";
import { textos, fill, md, crudo } from "../lib/contenido.js";
const tx = textos.proyectos.pagina;
const txc = textos.general.comunes;

const periodo = periodos().find((p) => p.vigente).id;
const proyectos = proyectosDeLey(periodo);
const sinNominal = proyectos.filter((p: any) => !p.votaciones).length;
const estados = [...new Map(proyectos.map((p: any) => [p.estadoFiltro, p.estado ?? txc.sinDato])).entries()].sort((a: any, b: any) => a[1].localeCompare(b[1], "es"));
const anios = [...new Set(proyectos.map((p: any) => p.anio).filter(Boolean))].sort().reverse();
const numero = (n: number) => n.toLocaleString("es-PY");
---

<Base
  titulo={tx.proyectosDeLey}
  descripcion={fill(tx.proyectosDeLeyDelCongreso, { proyectos: numero(proyectos.length), periodo: periodo })}
>
  <h1>{tx.proyectosDeLey}</h1>
  <div class="lectura">
    <p>
      {fill(tx.proyectosDeLeyDelPeriodo, { proyectos: numero(proyectos.length), periodo: periodo, sinNominal: numero(sinNominal) })}
    </p>
    <p class="chico texto-suave" set:html={md(tx.losProyectosSinVotacionNominal, { url1: crudo(rutas.metodologia(rutas.anclasMetodologia.proyectos)) })} />
  </div>

  <form class="filtro" id="filtro-proyectos" role="search" hidden>
    <div class="texto"><label for="proyecto-texto">{tx.palabrasDelTituloOExpediente}</label><input type="search" id="proyecto-texto" autocomplete="off" /></div>
    <div><label for="proyecto-estado">{txc.estado}</label><select id="proyecto-estado" data-campo="estado"><option value="">{txc.todos}</option>{estados.map(([v, t]) => <option value={v as string}>{t}</option>)}</select></div>
    <div><label for="proyecto-votacion">{tx.votacionNominal}</label><select id="proyecto-votacion" data-campo="nominal"><option value="">{tx.conOSin}</option><option value="si">{tx.conVotacionNominal}</option><option value="no">{tx.sinVotacionNominal}</option></select></div>
    <div><label for="proyecto-anio">{tx.anoDeIngreso}</label><select id="proyecto-anio" data-campo="anio"><option value="">{txc.todos}</option>{anios.map((a) => <option value={a as string}>{a}</option>)}</select></div>
    <p class="chico texto-suave" id="proyecto-estado-filtro" aria-live="polite"></p>
  </form>

  <ol class="proyectos" data-paginar>
    {proyectos.map((p: any) => <li data-proyecto={p.id} data-estado={p.estadoFiltro} data-nominal={p.votaciones ? "si" : "no"} data-anio={p.anio ?? ""}><p>{p.url ? <a href={p.url}>{txc.expediente} {p.expediente ?? tx.enSilpy}</a> : fill(txc.expedienteNumero, { expediente: p.expediente ?? txc.sinDatoMinuscula })} <span class="texto-suave">{p.titulo}</span></p><p class="chico texto-suave"><strong>{p.estado ?? txc.sinDato}</strong>{p.ley && <Fragment> · <a href={p.ley.url}>{fill(tx.ley, { numero: p.ley.numero })}</a></Fragment>}{p.votacion ? <Fragment> · <a href={p.votacion}>{p.votaciones === 1 ? tx.t1VotacionNominal : fill(tx.votacionesNominalesVerLaUltima, { votaciones: p.votaciones })}</a></Fragment> : tx.sinVotacionNominal2}{p.decision && fill(tx.enElPlenario, { resultado: p.decision.resultado, fecha: p.decision.fecha })}</p></li>)}
  </ol>
</Base>

<script>
  import interaccion from "../contenido/interaccion.json";
  import { fill } from "../lib/rellenar.js";
  const ti = interaccion.proyectos;
  const form = document.getElementById("filtro-proyectos") as HTMLFormElement;
  const estado = document.getElementById("proyecto-estado-filtro")!;
  const texto = document.getElementById("proyecto-texto") as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>("[data-proyecto]")];
  const selectores = [...form.querySelectorAll("select")];
  const normalizar = (t: string) => t.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();
  const textos = new Map(items.map((i) => [i, normalizar(i.firstElementChild!.textContent ?? "")]));
  const aplicar = () => {
    const buscado = normalizar(texto.value.trim());
    let cantidad = 0;
    for (const item of items) {
      const visible = selectores.every((s) => !s.value || item.dataset[s.dataset.campo!] === s.value) && textos.get(item)!.includes(buscado);
      item.hidden = !visible;
      if (visible) cantidad++;
    }
    estado.textContent = fill(ti.resultado, { visibles: cantidad.toLocaleString("es-PY"), total: items.length.toLocaleString("es-PY") });
  };
  form.hidden = false;
  form.addEventListener("input", aplicar);
  form.addEventListener("submit", (e) => e.preventDefault());
  aplicar();
</script>

<style>
  .filtro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--espacio-3);
    margin: var(--espacio-5) 0 var(--espacio-3);
  }
  .filtro[hidden] {
    display: none;
  }
  .filtro .texto,
  .filtro p {
    grid-column: 1 / -1;
  }
  .filtro p {
    margin: 0;
  }
  .proyectos {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .proyectos li {
    padding: var(--espacio-3) 0;
    border-top: var(--borde-ancho) solid var(--color-borde);
    overflow-wrap: anywhere;
  }
  .proyectos p {
    margin: 0 0 var(--espacio-1);
  }
</style>
