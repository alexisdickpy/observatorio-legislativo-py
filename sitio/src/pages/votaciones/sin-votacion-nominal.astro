---
// Decisiones del plenario sobre proyectos de ley sin votación nominal publicada (lib/decisiones.js): solo
// los textos oficiales, con filtros por año, cámara y resultado, sin gráficos porque no hay votos individuales.
import Base from "../../layouts/Base.astro";
import { periodos } from "../../lib/datos.js";
import { decisionesSinNominal } from "../../lib/decisiones.js";
import * as rutas from "../../lib/rutas.js";
import { textos, fill, md, crudo } from "../../lib/contenido.js";
const tx = textos.votaciones.sinNominal;
const txc = textos.general.comunes;

const periodo = periodos().find((p) => p.vigente).id;
const decisiones = decisionesSinNominal(periodo);
const opciones = (clave: string, texto: string) =>
  [...new Map(decisiones.map((d: any) => [d[clave], d[texto]])).entries()].filter(([v]) => v).sort((a: any, b: any) => String(a[1]).localeCompare(String(b[1]), "es"));
const anios = opciones("anio", "anio").reverse();
const camaras = opciones("camaraFiltro", "camara");
const resultados = opciones("resultadoFiltro", "resultado");
const numero = (n: number) => n.toLocaleString("es-PY");
---

<Base
  titulo={txc.decisionesSinVotacionNominal}
  descripcion={fill(tx.resultadoOficialDeDecisionesDel, { decisiones: numero(decisiones.length), periodo: periodo })}
>
  <p class="chico" set:html={md(tx.votaciones, { url1: crudo(rutas.votaciones()) })} />
  <h1>{txc.decisionesSinVotacionNominal}</h1>
  <div class="lectura">
    <p>
      {fill(tx.decisionesDelPlenarioSobreProyectos, { decisiones: numero(decisiones.length), periodo: periodo })}
    </p>
    <p class="chico texto-suave" set:html={md(tx.sinVotosIndividualesNoSe, { url1: crudo(rutas.metodologia(rutas.anclasMetodologia.decisiones)) })} />
  </div>

  <form class="filtro" id="filtro-decisiones" hidden>
    <div><label for="decision-anio">{tx.ano}</label><select id="decision-anio" data-campo="anio"><option value="">{txc.todos}</option>{anios.map(([v, t]) => <option value={v as string}>{t}</option>)}</select></div>
    <div><label for="decision-camara">{txc.camara}</label><select id="decision-camara" data-campo="camara"><option value="">{txc.lasDos}</option>{camaras.map(([v, t]) => <option value={v as string}>{t}</option>)}</select></div>
    <div><label for="decision-resultado">{tx.resultado}</label><select id="decision-resultado" data-campo="resultado"><option value="">{txc.todos}</option>{resultados.map(([v, t]) => <option value={v as string}>{t}</option>)}</select></div>
    <p class="chico texto-suave" id="decision-estado" aria-live="polite"></p>
  </form>

  <ol class="decisiones" data-paginar>
    {decisiones.map((d: any) => <li data-decision={d.id} data-anio={d.anio} data-camara={d.camaraFiltro} data-resultado={d.resultadoFiltro}><p class="resultado">{d.resultado}</p><p class="chico texto-suave">{d.fecha} · {d.camara ?? txc.sinDato} · {d.etapa ?? txc.sinDato}</p><p class="titulo">{d.ley && <Fragment><a href={d.ley.url}>{fill(tx.ley, { numero: d.ley.numero })}</a> </Fragment>}{d.url ? <a href={d.url}>{txc.expediente} {d.expediente ?? tx.enSilpy}</a> : d.expediente && fill(tx.expediente, { expediente: d.expediente })} <span class="texto-suave">{d.titulo}</span></p>{d.sesion && <p class="chico" set:html={md(tx.sesionEnSilpy, { url1: crudo(d.sesion) })} />}</li>)}
  </ol>
</Base>

<script>
  import interaccion from "../../contenido/interaccion.json";
  import { fill } from "../../lib/rellenar.js";
  const ti = interaccion.sinNominal;
  const form = document.getElementById("filtro-decisiones") as HTMLFormElement;
  const estado = document.getElementById("decision-estado")!;
  const items = [...document.querySelectorAll<HTMLElement>("[data-decision]")];
  const selectores = [...form.querySelectorAll("select")];
  const aplicar = () => {
    let cantidad = 0;
    for (const item of items) {
      const visible = selectores.every((s) => !s.value || item.dataset[s.dataset.campo!] === s.value);
      item.hidden = !visible;
      if (visible) cantidad++;
    }
    estado.textContent = fill(ti.resultado, { visibles: cantidad.toLocaleString("es-PY"), total: items.length.toLocaleString("es-PY") });
  };
  form.hidden = false;
  form.addEventListener("change", aplicar);
  form.addEventListener("submit", (e) => e.preventDefault());
  aplicar();
</script>

<style>
  .filtro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--espacio-3);
    margin: var(--espacio-5) 0 var(--espacio-3);
  }
  .filtro[hidden] {
    display: none;
  }
  .filtro p {
    grid-column: 1 / -1;
    margin: 0;
  }
  .decisiones {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .decisiones li {
    padding: var(--espacio-3) 0;
    border-top: var(--borde-ancho) solid var(--color-borde);
  }
  .decisiones p {
    margin: 0 0 var(--espacio-1);
  }
  .resultado {
    font-family: var(--fuente-titulo);
    font-size: var(--tamano-titulo-3);
  }
  .titulo {
    overflow-wrap: anywhere;
  }
</style>
