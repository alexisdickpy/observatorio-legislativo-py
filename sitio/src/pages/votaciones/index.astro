---
// Votaciones nominales del período vigente sobre proyectos de ley (lib/votaciones.js, alcance acordado
// en #44). Explica la posición de cada partido, enlaza a la página de cada año y muestra, por cámara,
// las votaciones más ajustadas.
import Base from "../../layouts/Base.astro";
import ListaVotaciones from "../../components/ListaVotaciones.astro";
import { periodos } from "../../lib/datos.js";
import { decisionesSinNominal } from "../../lib/decisiones.js";
import * as rutas from "../../lib/rutas.js";
import { CANTIDAD_AJUSTADAS, masAjustadas, votacionesDelPeriodo } from "../../lib/votaciones.js";
import { textos, fill, md, crudo } from "../../lib/contenido.js";
const tx = textos.votaciones.pagina;
const txc = textos.general.comunes;

const periodo = periodos().find((p) => p.vigente).id;
const { votaciones, anios, porCamara } = votacionesDelPeriodo(periodo);
const ajustadas = masAjustadas(periodo);
const decisiones = decisionesSinNominal(periodo);
const numero = (n: number) => n.toLocaleString("es-PY");
const plural = (n: number, singular: string, varios: string) => `${numero(n)} ${n === 1 ? singular : varios}`;
const porCamaraTexto = (lista: any[]) => lista.map((c) => `${c.camara} ${numero(c.total)}`).join(" · ");
---

<Base
  titulo={tx.votacionesYPosicionDeCada}
  descripcion={fill(tx.lasVotacionesNominalesSobreProyectos, { votaciones: numero(votaciones.length), periodo: periodo })}
>
  <h1>{tx.votacionesYPosicionDeCada}</h1>
  <div class="lectura">
    <p>
      {tx.las} {plural(votaciones.length, txc.votacionNominal, txc.votacionesNominales)} {fill(tx.sobreProyectosDeLeyDel, { periodo: periodo, porCamara: porCamaraTexto(porCamara) })}
    </p>
    <p class="formula">
      {tx.posicionDeUnPartidoLa}
    </p>
    <ul class="chico">
      <li set:html={md(tx.votosEmitidosSiNoAbstencion, {  })} />
      <li set:html={md(tx.siglasSonPropiasDeEste, {  })} />
      <li set:html={md(tx.totalesLosQuePublicaEl, {  })} />
    </ul>
    <p class="chico texto-suave" set:html={md(tx.partidoEsElQueLa, { url1: crudo(rutas.metodologia(rutas.anclasMetodologia.posicionPartidos)), url2: crudo(rutas.coincidencia()) })} />
  </div>

  <p class="lectura" set:html={md(tx.decisionesSinVotacionNominalCon, { url1: crudo(rutas.decisionesSinNominal()), decisiones: numero(decisiones.length) })} />

  <section aria-labelledby="titulo-anios">
    <h2 id="titulo-anios">{tx.votacionesPorAno}</h2>
    <p class="chico texto-suave">{tx.elAnoEsElDe}</p>
    <ul class="anios">
      {
        anios.map((a: any) => (
          <li data-anio={a.anio}>
            <a href={a.url}>{a.anio}</a> <span class="chico">{plural(a.total, txc.votacion, "votaciones")}</span>{" "}
            <span class="chico texto-suave">({porCamaraTexto(a.porCamara)})</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="titulo-ajustadas">
    <h2 id="titulo-ajustadas">{tx.votacionesMasAjustadas}</h2>
    <p class="lectura chico" set:html={md(tx.porCamaraLasVotacionesDel, { cantidad: CANTIDAD_AJUSTADAS, url1: crudo(rutas.metodologia(rutas.anclasMetodologia.masAjustadas)) })} />
    {
      ajustadas.map((c: any) => (
        <section data-camara-ajustadas>
          <h3>{c.camara ?? txc.sinDato}</h3>
          <ListaVotaciones votaciones={c.votaciones} diferencia />
        </section>
      ))
    }
  </section>
</Base>

<style>
  .formula {
    padding: var(--espacio-3) var(--espacio-4);
    background: var(--color-superficie);
    border-left: var(--foco-ancho) solid var(--color-acento);
  }
  .anios {
    list-style: none;
    padding: 0;
  }
  .anios li + li {
    margin-top: var(--espacio-2);
  }
  .anios a {
    font-weight: var(--peso-fuerte);
  }
</style>
